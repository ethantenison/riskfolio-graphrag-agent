<https://riskfolio-graphrag.io/kg/v2/Portfolio.py::chunk:144> a rf:Chunk ;
    rf:chunk_index 144 ;
    rf:chunk_kind "class" ;
    rf:content """axis=0)
        a = returns - u
        risk2 = cp.sum(Y) / T
        # madconstraints=[a @ w >= -Y, a @ w <= Y, Y >= 0]
        madconstraints = [a @ w * 1000 >= -Y * 1000, Y * 1000 >= 0]

        # Semi Variance Model Variables

        risk3 = cp.norm(Y, "fro") / cp.sqrt(T - 1)

        # CVaR Model Variables

        VaR_1 = cp.Variable((1, 1))
        alpha = self.alpha
        X = returns @ w
        Z1 = cp.Variable((T, 1))
        CVaR_L = VaR_1 + 1 / (alpha * T) * cp.sum(Z1)
        risk4 = CVaR_L
        cvarconstraints = [Z1 * 1000 >= 0, Z1 * 1000 >= -X * 1000 - VaR_1 * 1000]

        # Lower Partial Moment Variables

        lpm = cp.Variable((T, 1))
        lpmconstraints = [lpm * 1000 >= 0, lpm * 1000 >= rf0 * k * 1000 - X * 1000]

        # First Lower Partial Moment (Omega) Model Variables

        risk6 = cp.sum(lpm) / T

        # Second Lower Partial Moment (Sortino) Model Variables

        risk7 = cp.norm(lpm, "fro") / cp.sqrt(T - 1)

        # Drawdown Model Varia""" ;
