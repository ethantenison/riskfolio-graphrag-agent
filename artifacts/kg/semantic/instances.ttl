<https://riskfolio-graphrag.io/kg/v2/ConstraintsFunctions.py::chunk:15> a rf:Chunk ;
    rf:chunk_index 15 ;
    rf:chunk_kind "function" ;
    rf:content """constraints0 = constraints0[constraints0["Disabled"] == False]
    data = constraints0.values.tolist()

    n = len(constraints0)

    C = []
    D = []
    for i in range(0, n):
        if data[i][2] == ">=":
            d = 1
        elif data[i][2] == "<=":
            d = -1
        C1 = loadings[data[i][1]].values
        if data[i][4] != "":
            C2 = loadings[data[i][4]].values
            C1 = C2 - C1
        C.append(C1 * d)
        D.append([data[i][3] * d])

    C = -np.array(C, ndmin=2, dtype=float)
    D = -np.array(D, ndmin=2, dtype=float)

    return C, D""" ;
