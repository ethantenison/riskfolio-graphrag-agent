<https://riskfolio-graphrag.io/kg/v2/HCPortfolio.py::chunk:50> a rf:Chunk ;
    rf:chunk_index 50 ;
    rf:chunk_kind "function" ;
    rf:content """def __init__(
        self,
        returns=None,
        alpha=0.05,
        a_sim=100,
        beta=None,
        b_sim=None,
        kappa=0.30,
        kappa_g=None,
        solver_rl="CLARABEL",
        solvers=["CLARABEL", "SCS", "ECOS"],
        w_max=None,
        w_min=None,
    ):
        self._returns = returns
        self.alpha = alpha
        self.a_sim = a_sim
        self.beta = beta
        self.b_sim = b_sim
        self._kappa = kappa
        self._kappa_g = kappa_g
        self.solver_rl = solver_rl
