<https://riskfolio-graphrag.io/kg/v2/Tutorial%2050%20-%20Mean%20Relativistic%20Value%20at%20Risk%20Range%20(RVRG)%20Optimization.ipynb::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import numpy as np
import pandas as pd
import yfinance as yf
import warnings

warnings.filterwarnings("ignore")
pd.options.display.float_format = '{:.4%}'.format

# Date range
start = '2016-01-01'
end = '2019-12-30'

# Tickers of assets
assets = ['JCI', 'TGT', 'CMCSA', 'CPB', 'MO', 'APA', 'MMC', 'JPM',
          'ZION', 'PSA', 'BAX', 'BMY', 'LUV', 'PCAR', 'TXT', 'TMO',
          'DE', 'MSFT', 'HPQ', 'SEE', 'VZ', 'CNP', 'NI', 'T', 'BA']
assets.sort()

# Downloading data
data = yf.download(assets, start = start, end = end, auto_adjust=False)
data = data.loc[:,('Adj Close', slice(None))]
data.columns = assets""" ;
    rf:content_hash "99361312f8b00af325414206b1fc49736f09c0b8c9ccef69702ffeb70970c8de" ;
    rf:line_end 2 ;
    rf:line_start 2 ;
    rf:relative_path "Tutorial 50 - Mean Relativistic Value at Risk Range (RVRG) Optimization.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 50 - Mean Relativistic Value at Risk Range (RVRG) Optimization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2050%20-%20Mean%20Relativistic%20Value%20at%20Risk%20Range%20(RVRG)%20Optimization.ipynb::chunk:3> a rf:Chunk ;
    rf:chunk_index 3 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Calculating returns

Y = data[assets].pct_change().dropna()

display(Y.head())""" ;
    rf:content_hash "ad303cc6847b0fa655402f474851b1917419f03d61216e63c6270c4897d82721" ;
    rf:line_end 3 ;
    rf:line_start 3 ;
    rf:relative_path "Tutorial 50 - Mean Relativistic Value at Risk Range (RVRG) Optimization.ipynb" ;
    rf:section "example_cell" ;
