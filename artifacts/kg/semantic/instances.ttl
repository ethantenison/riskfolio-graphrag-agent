<https://riskfolio-graphrag.io/kg/v2/HCPortfolio.py::chunk:58> a rf:Chunk ;
    rf:chunk_index 58 ;
    rf:chunk_kind "function" ;
    rf:content """def _naive_risk(self, returns, cov, rm="MV", rf=0):
        assets = returns.columns.tolist()
        n = len(assets)

        if rm == "equal":
            weights = np.ones((n, 1)) * 1 / n
        else:
            inv_risk = np.zeros((n, 1))
            for i in assets:
                k = assets.index(i)
                w = np.zeros((n, 1))
                w[k, 0] = 1
                w = pd.DataFrame(w, columns=["weights"], index=assets)
                if rm == "vol":
                    risk = rk.Sharpe_Risk(
                        returns=returns,
                        w=w,
                        cov=cov,
                        rm="MV",
                        rf=rf,
                        alpha=self.alpha,
                        a_sim=self.a_sim,
                        beta=self.beta,
                        b_sim=self.b_sim,
                        kappa=self.kappa,
                        kappa_g=self.kappa_g,
                        solver=self.solver_rl,""" ;
    rf:content_hash "5ea40984c13f8b0d3fc00c42d2dd6c9715445fbe2f7b65f9695529cf5997933a" ;
