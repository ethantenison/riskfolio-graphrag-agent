        Mdjv = np.zeros(
            (N, len(indx))
        )  # Set the cluster membership matrix for vertices in the converging bubbles at default
        Mdjv[cv, :] = Bubv[
            cv, :
        ].copy()  # Assign vertices which belong to single converging bubbles to the r""" ;
