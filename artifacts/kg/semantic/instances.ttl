    rf:chunk_kind "function" ;
    rf:content """k([w1, np.ones((1, 1))])
        M3 = cp.hstack([M1, M2])

        risk = cp.trace(B2.T @ sigma @ B2 @ W1)
        constraints += [M3 >> 0]

        # Return Variables

        if model == "Classic":
            if kelly == "exact":
                if obj == "Sharpe":
                    ret = 1 / T * cp.sum(gr)
                    constraints += [cp.ExpCone(gr, onesvec @ k, k + returns @ w)]
                else:
                    ret = 1 / T * cp.sum(cp.log(1 + returns @ w))
            elif kelly == "approx":
                if obj == "Sharpe":
                    ret = mu @ w - 0.5 * cp.quad_over_lin(g, k)
                    constraints += [cp.SOC(g, sqrtm(sigma) @ w)]
                else:
                    ret = mu @ w - 0.5 * g**2
            elif kelly is None:
                ret = mu @ w
        else:
            ret = mu @ w

        # Problem Weight Constraints

        if obj == "Sharpe":
            constraints += [cp.sum(w) == self.budget * k, k * 1000 >= 0]""" ;
