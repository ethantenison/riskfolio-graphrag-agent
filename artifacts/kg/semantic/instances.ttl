<https://riskfolio-graphrag.io/kg/v2/ConstraintsFunctions.py::chunk:84> a rf:Chunk ;
    rf:chunk_index 84 ;
    rf:chunk_kind "function" ;
    rf:content """sets_clusters(
        returns=returns,
        custom_cov=custom_cov,
        codependence=codependence,
        linkage=linkage,
        opt_k_method=opt_k_method,
        k=k,
        max_k=max_k,
        bins_info=bins_info,
        alpha_tail=alpha_tail,
        gs_threshold=gs_threshold,
        leaf_order=leaf_order,
    )

    df = pd.DataFrame([], index=assets)

    for i in clusters["Clusters"].unique():
        labels = clusters[clusters["Clusters"] == i]["Assets"].tolist()
        df1 = pd.Series(np.zeros((n,)), index=assets)
        df1[labels] = 1
        df = pd.concat([df, df1], axis=1)

    A_c = df.to_numpy()
    A_c = A_c @ A_c.T - np.identity(n)

    return A_c""" ;
    rf:content_hash "9ac7e9fab90b46d43064c75c9433eed6686884bc2f6ac56daa66acc8c6e74ca4" ;
