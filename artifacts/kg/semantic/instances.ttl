<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import numpy as np
import pandas as pd
import yfinance as yf
import warnings

warnings.filterwarnings("ignore")
pd.options.display.float_format = '{:.4%}'.format

# Date range
start = '2016-01-01'
end = '2019-12-30'

# Tickers of assets
assets = ['JCI', 'TGT', 'CMCSA', 'CPB', 'MO', 'APA', 'MMC', 'JPM',
          'ZION', 'PSA', 'BAX', 'BMY', 'LUV', 'PCAR', 'TXT', 'TMO',
          'DE', 'MSFT', 'HPQ', 'SEE', 'VZ', 'CNP', 'NI', 'T', 'BA']
assets.sort()

# Downloading data
data = yf.download(assets, start = start, end = end, auto_adjust=False)
data = data.loc[:,('Adj Close', slice(None))]
data.columns = assets""" ;
    rf:content_hash "560632362534e3ffa432aa4e5f80461cd465cfd9c0bc13df2a2a1f60f349315f" ;
    rf:line_end 2 ;
    rf:line_start 2 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:3> a rf:Chunk ;
    rf:chunk_index 3 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Calculating returns

Y = data[assets].pct_change().dropna()

display(Y.head())""" ;
    rf:content_hash "711e8650b1de53e823dcdf047cfe903006ad447f7a9aff8c37e949b528f945e5" ;
    rf:line_end 3 ;
    rf:line_start 3 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:4> a rf:Chunk ;
    rf:chunk_index 4 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import riskfolio as rp

# Plotting Assets Clusters

ax = rp.plot_clusters(returns=Y,
                      codependence='pearson',
                      linkage='ward',
                      k=None,
                      max_k=10,
                      leaf_order=True,
                      dendrogram=True,
                      #linecolor='tab:purple',
                      ax=None)""" ;
    rf:content_hash "d056469a7e388440a628265c6bd1f0ee0ad91716bad009a2f267bd6a4abdbe31" ;
    rf:line_end 4 ;
    rf:line_start 4 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
    rf:chunk_kind "example_section" ;
    rf:content """The graph above suggest that optimal number of clusters are four.

## 2. Estimating HERC and HERC2 Portfolios

The HERC2 portfolio is just a modification of HERC portfolio making the weights within clusters equal and no based on naive risk parity like original HERC portfolio.

### 2.1 Calculating the HERC and HERC2 portfolios""" ;
    rf:content_hash "95af98c7a9769ec5c4672ce41919f14103b60c72b603cff6af844e30fa335976" ;
    rf:line_end 5 ;
    rf:line_start 5 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:6> a rf:Chunk ;
    rf:chunk_index 6 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Building the portfolio object
port = rp.HCPortfolio(returns=Y)

# Estimate optimal portfolio:

codependence = 'pearson' # Correlation matrix used to group assets in clusters
rm = 'MV' # Risk measure used, this time will be variance
rf = 0 # Risk free rate
linkage = 'ward' # Linkage method used to build clusters
max_k = 10 # Max number of clusters used in two difference gap statistic
leaf_order = True # Consider optimal order of leafs in dendrogram

w1 = port.optimization(model='HERC',
                       codependence=codependence,
                       method_cov='hist',
                       rm=rm,
                       rf=rf,
                       linkage=linkage,
                       max_k=max_k,
                       leaf_order=leaf_order)

w2 = port.optimization(model='HERC2',
                       codependence=codependence,
                       method_cov='hist',
                       rm=rm,
                       rf=rf,
                       linkage=linkage,""" ;
    rf:content_hash "23dcec04dd25f2ef486b126b75b89c456414458f27d322bc7d77bcd46b29349c" ;
    rf:line_end 6 ;
    rf:line_start 6 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:7> a rf:Chunk ;
    rf:chunk_index 7 ;
    rf:chunk_kind "example_cell" ;
    rf:content """rm=rm,
                       rf=rf,
                       linkage=linkage,
                       max_k=max_k,
                       leaf_order=leaf_order)

w = pd.concat([w1, w2], axis=1)
w.columns = ['HERC', 'HERC2']

display(w.sort_values(by='HERC', ascending=False).style.format("{:.2%}").background_gradient(cmap='YlGn'))""" ;
    rf:content_hash "42ebb11a2df0b880fa928fd8f5b1aaf3e58af34a62b949a21e4b638d0927642a" ;
    rf:line_end 6 ;
    rf:line_start 6 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:8> a rf:Chunk ;
    rf:chunk_index 8 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 2.2 Plotting Risk Contribution" ;
    rf:content_hash "e4a40040225a366b75d78b1a6d4e7bdfa97755bdd7ccdc3fa598410a2070cbae" ;
    rf:line_end 7 ;
    rf:line_start 7 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:9> a rf:Chunk ;
    rf:chunk_index 9 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import matplotlib.pyplot as plt

# Plotting the risk contribution per asset

mu = Y.mean()
cov = Y.cov() # Covariance matrix
returns = Y # Returns of the assets

fig, ax = plt.subplots(2,1, figsize=(12, 12))

ax = np.ravel(ax)
rp.plot_risk_con(w=w1,
                 cov=cov,
                 returns=returns,
                 rm=rm,
                 rf=0,
                 alpha=0.05,
                 color="tab:blue",
                 height=6,
                 width=10,
                 t_factor=252,
                 ax=ax[0])

rp.plot_risk_con(w=w2,
                 cov=cov,
                 returns=returns,
                 rm=rm,
                 rf=0,
                 alpha=0.05,
                 color="tab:blue",
                 height=6,
                 width=10,
                 t_factor=252,
                 ax=ax[1])""" ;
    rf:content_hash "eabc5b74a9768a198fc9b09d61b449ca5cb59b4083cf928d4294603b682a919b" ;
    rf:line_end 8 ;
    rf:line_start 8 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

