<https://riskfolio-graphrag.io/kg/v2/Tutorial%2041%20-%20Mean%20Relativistic%20Drawdown%20at%20Risk%20(RLDaR)%20Optimization.ipynb::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import numpy as np
import pandas as pd
import yfinance as yf
import warnings

warnings.filterwarnings("ignore")
pd.options.display.float_format = '{:.4%}'.format

# Date range
start = '2016-01-01'
end = '2019-12-30'

# Tickers of assets
assets = ['JCI', 'AMZN', 'CMCSA', 'CPB', 'MO', 'APA', 'MMC', 'JPM',
          'ZION', 'AAPL', 'BAX', 'BMY', 'LUV', 'PCAR', 'TXT', 'TMO',
          'DE', 'MSFT', 'HPQ', 'SEE', 'VZ', 'CNP', 'NI', 'T', 'BA']
assets.sort()

# Downloading data
data = yf.download(assets, start = start, end = end, auto_adjust=False)
data = data.loc[:,('Adj Close', slice(None))]
data.columns = assets""" ;
    rf:content_hash "df4bcd1ac59d556f62e1c3c7861aa3033678910e0390344a17c9a7c075801c60" ;
    rf:line_end 2 ;
    rf:line_start 2 ;
    rf:relative_path "Tutorial 41 - Mean Relativistic Drawdown at Risk (RLDaR) Optimization.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 41 - Mean Relativistic Drawdown at Risk (RLDaR) Optimization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2041%20-%20Mean%20Relativistic%20Drawdown%20at%20Risk%20(RLDaR)%20Optimization.ipynb::chunk:20> a rf:Chunk ;
