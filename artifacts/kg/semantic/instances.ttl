<https://riskfolio-graphrag.io/kg/v2/Tutorial%2020%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman%20and%20Risk%20Factors%20Models.ipynb::chunk:14> a rf:Chunk ;
    rf:chunk_index 14 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Building the Portfolio Object
########################################################################

# Building the portfolio object
port = rp.Portfolio(returns=Y)

# Select method and estimate input parameters:
method_mu='hist' # Method to estimate expected returns based on historical data.
method_cov='hist' # Method to estimate covariance matrix based on historical data.

port.assets_stats(method_mu=method_mu,
                  method_cov=method_cov)

port.factors = X
port.factors_stats(method_mu=method_mu,
                   method_cov=method_cov,
                   B=loadings,
                   const=False)""" ;
    rf:content_hash "3dba98cd82c471defc244d1a8bb3fd352f13f9333da613f3c2d4ba512b7d9d71" ;
    rf:line_end 13 ;
    rf:line_start 13 ;
    rf:relative_path "Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2020%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman%20and%20Risk%20Factors%20Models.ipynb::chunk:15> a rf:Chunk ;
    rf:chunk_index 15 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Calculating optimum portfolios using Mean Vector and
# Covariance Matrix of Black Litterman with Factors
########################################################################

port.alpha = 0.05
rm = 'MV' # Risk measure used, this time will be variance
obj = 'Sharpe' # Objective function, could be MinRisk, MaxRet, Utility or Sharpe
hist = False # False: BL covariance and risk factors scenarios
         # True: historical covariance and scenarios
         # 2: risk factors covariance and scenarios
rf = 0 # Risk free rate
l = 0 # Risk aversion factor, only useful when obj is 'Utility'

w_fm = port.optimization(model='FM', rm=rm, obj=obj, rf=rf, l=l, hist=hist) 

# Estimate Portfolio weights using Black Litterman Bayesian Model:
port.blfactors_stats(flavor='BLB',
                     B=loadings,
                     P_f=P_f,
                     Q_f=Q_f/252,
                     rf=0,
                     delta=N""" ;
    rf:content_hash "263cdfa5e3d6a48b469b9857e133445459263148d0c01118b80a5800e05929f9" ;
    rf:line_end 14 ;
    rf:line_start 14 ;
    rf:relative_path "Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2020%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman%20and%20Risk%20Factors%20Models.ipynb::chunk:16> a rf:Chunk ;
    rf:chunk_index 16 ;
    rf:chunk_kind "example_cell" ;
    rf:content """P_f=P_f,
                     Q_f=Q_f/252,
                     rf=0,
                     delta=None,
                     eq=True,
                     const=False,
                     method_mu=method_mu,
                     method_cov=method_cov)

w_blb = port.optimization(model='BL_FM', rm=rm, obj=obj, rf=rf, l=l, hist=hist)

# Estimate Portfolio weights using Augmented Black Litterman Model:
port.blfactors_stats(flavor='ABL',
                     B=loadings,
                     P_f=P_f,
                     Q_f=Q_f/252,
                     rf=0,
                     delta=None,
                     eq=True,
                     const=False,
                     method_mu=method_mu,
                     method_cov=method_cov)

w_abl = port.optimization(model='BL_FM', rm=rm, obj=obj, rf=rf, l=l, hist=hist)

ws = pd.concat([w_fm, w_blb, w_abl], axis=1)
ws.columns = ['Pure Factors', 'Bayesian BL', 'Augmented BL']

display(ws.style.format("{:.4%}").background_gradient(cmap='YlGn""" ;
    rf:content_hash "f97dbaa77289fd37d097b751fe07f3661c412ff326bfc893641a104777eedf50" ;
    rf:line_end 14 ;
    rf:line_start 14 ;
    rf:relative_path "Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2020%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman%20and%20Risk%20Factors%20Models.ipynb::chunk:17> a rf:Chunk ;
    rf:chunk_index 17 ;
    rf:chunk_kind "example_cell" ;
    rf:content """s', 'Bayesian BL', 'Augmented BL']

display(ws.style.format("{:.4%}").background_gradient(cmap='YlGn'))""" ;
    rf:content_hash "ae7a0bba92049e8866545c716ac33bcca1a7d60460e6073feb4c712955bdd0c1" ;
    rf:line_end 14 ;
    rf:line_start 14 ;
    rf:relative_path "Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2020%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman%20and%20Risk%20Factors%20Models.ipynb::chunk:18> a rf:Chunk ;
    rf:chunk_index 18 ;
    rf:chunk_kind "example_section" ;
    rf:content """We can see that the we got a messsage that the covariance matrix is not a positive definite matrix, this is common when we work with views on assets or risk factors. In this case, Riskfolio-Lib replace the negative eigenvalues of covariance matrix with zeros and reconstruct the covariance matrix. The problem with this approach is common that the weights that we will get are highly concetrated in few assets.

Other approach is using the mean vector estimated with Black Litterman with Factors and the covariance matrix that we get from historical returns or a factor model. An example with this approach follows:""" ;
    rf:content_hash "2b9047e12808ffed056aad8f4f4055465098c343036835f271620d8373bb4993" ;
    rf:line_end 15 ;
    rf:line_start 15 ;
    rf:relative_path "Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2020%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman%20and%20Risk%20Factors%20Models.ipynb::chunk:19> a rf:Chunk ;
    rf:chunk_index 19 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 2.4 Building Portfolios with mean vector from Black Litterman with Factors." ;
    rf:content_hash "4e2d80ecc8363563931a40675285d1ca133cf7fa3b8fd439c10df656c1b63756" ;
    rf:line_end 16 ;
    rf:line_start 16 ;
    rf:relative_path "Tutorial 20 - Mean Risk Optimization using Black Litterman and Risk Factors Models.ipynb" ;
