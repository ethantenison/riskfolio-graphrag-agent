<https://riskfolio-graphrag.io/kg/v2/Tutorial%2047%20-%20Risk%20Parity%20with%20Risk%20Factors.ipynb::chunk:6> a rf:Chunk ;
    rf:chunk_index 6 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 2.2 Calculating the Factor Risk Parity Portfolio based on Market Factors" ;
    rf:content_hash "86e031b68fa3176a6a5af096a57271c93af754276a4dc4c120ebba236176187d" ;
    rf:line_end 6 ;
    rf:line_start 6 ;
