<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:10> a rf:Chunk ;
    rf:chunk_index 10 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 2.3 Calculate Optimal HERC and HERC2 Portfolios for Several Covariance Estimators" ;
    rf:content_hash "c4966b171d8c58069dc15fff87e87bb27f7374dc01935334ec0f5d2d7b8aa302" ;
    rf:line_end 9 ;
    rf:line_start 9 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:11> a rf:Chunk ;
    rf:chunk_index 11 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Covariance estimators available:
#
# 'hist': use historical estimates.
# 'ewma1'': use ewma with adjust=True, see `EWM <https://pandas.pydata.org/pandas-docs/stable/user_guide/computation.html#exponentially-weighted-windows>`_ for more details.
# 'ewma2': use ewma with adjust=False, see `EWM <https://pandas.pydata.org/pandas-docs/stable/user_guide/computation.html#exponentially-weighted-windows>`_ for more details.
# 'ledoit': use the Ledoit and Wolf Shrinkage method.
# 'oas': use the Oracle Approximation Shrinkage method.
# 'shrunk': use the basic Shrunk Covariance method.

models = ['HERC'] * 6 + ['HERC2'] * 6
covariances = ['hist', 'ewma1', 'ewma2', 'ledoit', 'oas', 'shrunk'] * 2

w_s = pd.DataFrame([])

for i,j in zip(models, covariances):
    w = port.optimization(model=i,
                          codependence=codependence,
                          method_cov=j,
                          rm=rm,
                          rf=rf,
                          linkage=linkage,""" ;
    rf:content_hash "5ef25dac0bd919f4a8ef6e1c8977f60c20f8b156157bbb018439fc875df68895" ;
    rf:line_end 10 ;
    rf:line_start 10 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2027%20-%20HERC%20with%20Equal%20Weights%20within%20Clusters%20(HERC2).ipynb::chunk:12> a rf:Chunk ;
    rf:chunk_index 12 ;
    rf:chunk_kind "example_cell" ;
    rf:content """rm=rm,
                          rf=rf,
                          linkage=linkage,
                          max_k=max_k,
                          leaf_order=leaf_order)

    w_s = pd.concat([w_s, w], axis=1)
    
w_s.columns = zip(models, covariances)""" ;
    rf:content_hash "930448c15836185a9a61a50f078ae2ed1af64ab196e648b2fa647a1be0d7b2fe" ;
    rf:line_end 10 ;
    rf:line_start 10 ;
    rf:relative_path "Tutorial 27 - HERC with Equal Weights within Clusters (HERC2).ipynb" ;
