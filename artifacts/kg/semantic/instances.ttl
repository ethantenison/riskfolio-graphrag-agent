    rf:content """nts = [cp.SOC(g, G.T @ w)]

        # Return Variables

        if kelly == "exact":
            if obj == "Sharpe":
                ret = 1 / T * cp.sum(gr)
            else:
                ret = 1 / T * cp.sum(cp.log(1 + returns @ w))
        elif kelly == "approx":
            if obj == "Sharpe":
                ret = mu @ w - 0.5 * cp.quad_over_lin(g, k)
            else:
                ret = mu @ w - 0.5 * g**2
        elif kelly is None:
            ret = mu @ w

        # SDP Model Variables

        penalty_factor = cp.Constant(0)
        sdpmodel = False
        if self.network_sdp is not None or self.cluster_sdp is not None:
            sdpmodel = True

        if sdpmodel:
            W = cp.Variable((N, N), symmetric=True)
            M1 = cp.vstack([W, w.T])
            if obj == "Sharpe":
                M2 = cp.vstack([w, k])
            else:
                M2 = cp.vstack([w, np.ones((1, 1))])
            M3 = cp.hstack([M1, M2])
            sdpconstraints = [M3 >> 0""" ;
