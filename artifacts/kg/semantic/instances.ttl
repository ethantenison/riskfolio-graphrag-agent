<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:12> a rf:Chunk ;
    rf:chunk_index 12 ;
    rf:chunk_kind "example_section" ;
    rf:content """## 3. Optimization with Key Rate Durations Constraints

This part shows how __Riskfolio-Lib__ can be used to build immunized portfolios using __duration matching__ and __convexity matching__, however the example only use duration matching. More information about immunization theory can be found in this __[link](https://www.investopedia.com/terms/i/immunization.asp)__.

### 3.1 Statistics of Risk Factors""" ;
    rf:content_hash "dbaa60a99166a6dcc76cf7eb668a7ec33107f404332b206441f91828ceab3752" ;
    rf:line_end 10 ;
    rf:line_start 10 ;
    rf:relative_path "Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:13> a rf:Chunk ;
    rf:chunk_index 13 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Displaying factors statistics
########################################################################

table = pd.concat([loadings.min(), loadings.max()], axis=1)
table.columns = ['min', 'max']
display(table.iloc[:9,:].style.format("{:.4f}").background_gradient(cmap='YlGn'))
display(X.iloc[:,:9].corr().style.format("{:.4f}").background_gradient(cmap='YlGn'))""" ;
    rf:content_hash "35b79b39e9a5acfe037cdc8f513b5dde491af86e430c7f16f35a68abc7c40d49" ;
    rf:line_end 11 ;
    rf:line_start 11 ;
