                      color="tab:blue", height=6, width=10, ax=None)""" ;
    rf:content_hash "91533b0dd75112f73446b4027b081a2f09555dab6fc5b1d81b781429cd02738d" ;
    rf:line_end 19 ;
    rf:line_start 19 ;
