    rf:content """## 2. Estimating Mean Variance Portfolios with Short Weights
### 2.1 Calculating the portfolio that maximizes Sharpe ratio.""" ;
    rf:content_hash "7b160cb152aa187d1871df067282e73b08f96cb43632005ace007b91aea47267" ;
    rf:line_end 4 ;
    rf:line_start 4 ;
    rf:relative_path "Tutorial 8 - Short and Leveraged Portfolios.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 8 - Short and Leveraged Portfolios.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%208%20-%20Short%20and%20Leveraged%20Portfolios.ipynb::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import riskfolio as rp

# Building the portfolio object
port = rp.Portfolio(returns=Y)

# Calculating optimal portfolio

# Select method and estimate input parameters:

method_mu='hist' # Method to estimate expected returns based on historical data.
method_cov='hist' # Method to estimate covariance matrix based on historical data.

port.assets_stats(method_mu=method_mu, method_cov=method_cov)

# Configuring short weights options

port.sht = True # Allows to use Short Weights

port.uppersht = 0.3 # Maximum absolute value of individual negative weights
port.upperlng = 1.3 # Maximum value of individual positive weights
port.budget = 1.0 # Sum of all weights
port.budgetsht = 0.3 # Maximum absolute value of sum of negative weights

# Estimate optimal portfolio:

model='Classic' # Could be Classic (historical), BL (Black Litterman) or FM (Factor Model)
rm = 'MV' # Risk measure used, this time will be variance
obj = 'Sharpe' # Objective function, could be MinRisk, MaxRet, Utility or Sharpe
hi""" ;
    rf:content_hash "08ef91e8962683916df585465121e3b7903e67a24659c8c66e8bc75cf386eb1e" ;
    rf:line_end 5 ;
    rf:line_start 5 ;
    rf:relative_path "Tutorial 8 - Short and Leveraged Portfolios.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 8 - Short and Leveraged Portfolios.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%208%20-%20Short%20and%20Leveraged%20Portfolios.ipynb::chunk:6> a rf:Chunk ;
    rf:chunk_index 6 ;
    rf:chunk_kind "example_cell" ;
    rf:content """will be variance
obj = 'Sharpe' # Objective function, could be MinRisk, MaxRet, Utility or Sharpe
hist = True # Use historical scenarios for risk measures that depend on scenarios
rf = 0 # Risk free rate
l = 0 # Risk aversion factor, only useful when obj is 'Utility'

w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)

display(w.T)""" ;
    rf:content_hash "3cba8d43f21964c6cc3bb32f21d990ab79c6f61baf56a4fee076ffcb07839b46" ;
    rf:line_end 5 ;
