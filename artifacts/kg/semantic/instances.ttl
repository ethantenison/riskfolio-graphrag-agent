<https://riskfolio-graphrag.io/kg/v2/Tutorial%2028%20-%20Hierarchical%20Clustering%20and%20Networks.ipynb::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import matplotlib.pyplot as plt
import riskfolio as rp

# Comparison of several linkages methods

linkages = ['single','complete','average','weighted',
            'centroid', 'median', 'ward','DBHT']

fig, ax = plt.subplots(len(linkages), 1, figsize=(12, 30))
ax = np.ravel(ax)

j = 0
for i in linkages:
    ax[j] = rp.plot_dendrogram(returns=Y,
                               codependence='pearson',
                               linkage=i,
                               opt_k_method="twodiff",
                               k=None,
                               max_k=10,
                               leaf_order=True,
                               ax=ax[j])
    j += 1
    
plt.plot()""" ;
    rf:content_hash "3e087c18f54ac8b336de61aecbf9c193cb5baa9bf2852ae5ecefff5c31aaadbd" ;
    rf:line_end 5 ;
    rf:line_start 5 ;
    rf:relative_path "Tutorial 28 - Hierarchical Clustering and Networks.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 28 - Hierarchical Clustering and Networks.ipynb" .

