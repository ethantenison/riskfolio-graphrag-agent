<https://riskfolio-graphrag.io/kg/v2/ConstraintsFunctions.py::chunk:69> a rf:Chunk ;
    rf:chunk_index 69 ;
    rf:chunk_kind "function" ;
    rf:content """um_spanning_tree(MAdj)
    else:
        raise ValueError("Only TMFG or MST graphs are available")

    A = nx.adjacency_matrix(G).toarray()
    A = np.where(A != 0, 1, 0)

    A_p = np.zeros_like(A)
    for i in range(int(walk_size) + 1):
        A_p += np.linalg.matrix_power(A, i)

    n, n = A.shape
    A_p = np.clip(A_p, 0, 1) - np.identity(n)
    A_p = np.ceil(A_p)

    return A_p""" ;
