    Mv : nd-array
        Bubble membership of vertices from BubbleCluster8s.

    Returns
    -------
    Z : nd-array
        (N-1) x 4 linkage matrix, in the same format as the output from matlab
        function 'linkage'.
    \"\"\"

    N = Dpm.shape[0]
    kvec = np.int32(np.unique(Tc))
    LabelVec1 = np.arange(0, N)
    # LinkageDist = np.zeros((1,1))
    E = sp.csr_matrix(""" ;
