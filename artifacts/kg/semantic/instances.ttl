<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:28> a rf:Chunk ;
    rf:chunk_index 28 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Displaying factors statistics
########################################################################

table = pd.concat([loadings.min(), loadings.max()], axis=1)
table.columns = ['min', 'max']
display(table.iloc[:16,:].style.format("{:.4f}").background_gradient(cmap='YlGn'))
display(X.iloc[:,:16].corr().style.format("{:.4f}").background_gradient(cmap='YlGn'))""" ;
    rf:content_hash "a9a6e71daea395fab3259f136aa1bed054891383886e45b392526125518e0b41" ;
