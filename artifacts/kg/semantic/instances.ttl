    rf:chunk_index 23 ;
    rf:chunk_kind "example_cell" ;
    rf:content """rm = 'CVaR' # Risk measure

w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)

display(w.T)""" ;
    rf:content_hash "43f4f788cae6f5f9731a0fa11ac901c8f03a5b190c8d3fffc6a5851febe43d61" ;
