<https://riskfolio-graphrag.io/kg/v2/Tutorial%2035%20-%20Gini%20Mean%20Difference%20(GMD)%20Optimization.ipynb::chunk:3> a rf:Chunk ;
    rf:chunk_index 3 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Calculating returns

