    rf:content "### 3.4 Calculate Optimal Portfolios for Several Risk Measures" ;
    rf:content_hash "3ba98d836c972851481f76103ccdc3b013cc7cc93828e971a387318b0a561a36" ;
    rf:line_end 16 ;
    rf:line_start 16 ;
    rf:relative_path "Tutorial 10 - Risk Parity Portfolio Optimization.ipynb" ;
    rf:section "example_section" ;
