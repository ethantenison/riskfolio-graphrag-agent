    @property
    def kappa_g(self):
        return self._kappa_g

    @kappa_g.setter
    def kappa_g(self, value):
        a = value
        if a >= 1:
            print(
                "kappa must be between 0 and 1, values higher or equal to 1 are setting to 0.99."
            )
            self._kappa_g = 0.99
        elif a <= 0:
            print(
                "kappa must be between 0 and 1, values lower or equal to 0 are setting to 0.01."
            )
            self._kappa_g = 0.01
