<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:14> a rf:Chunk ;
    rf:chunk_index 14 ;
    rf:chunk_kind "example_section" ;
    rf:content """### 3.2 Creating Constraints on Key Rate Durations

In this example we are going to put a limit on the maximum duration that the portfolio can reach. The key rate durations of portfolio for 1800, 3600 and 7200 days will be lower than -2, -2 and -3.""" ;
    rf:content_hash "a27418fd64e80a62d1aa555f9abcab80af860e2e4302438888a53e73896f1d93" ;
    rf:line_end 12 ;
    rf:line_start 12 ;
    rf:relative_path "Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:15> a rf:Chunk ;
    rf:chunk_index 15 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Creating durations constraints
########################################################################

constraints = {'Disabled': [False, False, False],
               'Factor': ['R 1800', 'R 3600', 'R 7200'],
               'Sign': ['<=', '<=', '<='],
               'Value': [-2, -2, -3],
               'Relative Factor': ['', '', '']}

constraints = pd.DataFrame(constraints)

display(constraints)""" ;
    rf:content_hash "0a9a01df2bf86bfdd9ee085ada713528e35fd55d2a5ed4df20ecbf73f336ed4d" ;
    rf:line_end 13 ;
