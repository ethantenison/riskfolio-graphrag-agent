<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:24> a rf:Chunk ;
    rf:chunk_index 24 ;
    rf:chunk_kind "function" ;
    rf:content """for i in NAV:
        if i > peak:
            peak = i
        DD = peak - i
        if DD > 0:
            value += DD
        n += 1
    if n == 0:
        value = 0
    else:
        value = value / (n - 1)

    value = np.array(value).item()

    return value""" ;
