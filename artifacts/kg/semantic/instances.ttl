<https://riskfolio-graphrag.io/kg/v2/Tutorial%203%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman.ipynb::chunk:10> a rf:Chunk ;
    rf:chunk_index 10 ;
    rf:chunk_kind "example_cell" ;
    rf:content """P, Q = rp.assets_views(views, asset_classes)

display(pd.DataFrame(P.T))
display(pd.DataFrame(Q))""" ;
    rf:content_hash "0628ca6f8ed30c31fdcec7e302a08682332fe13d68ce3cad4338e68ea07a0eeb" ;
    rf:line_end 9 ;
