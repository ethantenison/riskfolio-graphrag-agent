<https://riskfolio-graphrag.io/kg/v2/AuxFunctions.py::chunk:20> a rf:Chunk ;
    rf:chunk_index 20 ;
    rf:chunk_kind "function" ;
    rf:content """def ltdi_matrix(X, alpha=0.05):
    r\"\"\"
    Calculate the lower tail dependence index matrix using the empirical
    approach.

    Parameters
    ----------
    X : DataFrame of shape (n_samples, n_assets)
        Assets returns DataFrame, where n_samples is the number of
        observations and n_assets is the number of assets.
    alpha : float, optional
        Significance level for lower tail dependence index.
        The default is 0.05.

    Returns
    -------
    corr : ndarray
        The lower tail dependence index matrix of shape n_features x
        n_features.

    Raises
    ------
        ValueError when the value cannot be calculated.

    \"\"\"

    flag = False
    if isinstance(X, pd.DataFrame):
        cols = X.columns.tolist()
        X1 = X.to_numpy()
        flag = True
    else:
        X1 = X.copy()

    m = X1.shape[0]
    n = X1.shape[1]
    k = np.int32(np.ceil(m * alpha))
    mat = np.ones((n, n))

    if k > 0:
        indices = np.triu_indices(n)""" ;
    rf:content_hash "a1391c297641cc5e9fc7eb54385ed760c160fbf7b9e4bf4d2c79585c69797515" ;
    rf:line_end 646 ;
    rf:line_start 607 ;
    rf:relative_path "AuxFunctions.py" ;
    rf:section "ltdi_matrix" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/AuxFunctions.py" .

<https://riskfolio-graphrag.io/kg/v2/AuxFunctions.py::chunk:21> a rf:Chunk ;
    rf:chunk_index 21 ;
    rf:chunk_kind "function" ;
    rf:content """eil(m * alpha))
    mat = np.ones((n, n))

    if k > 0:
        indices = np.triu_indices(n)

        for i, j in zip(indices[0], indices[1]):
            u = np.sort(X1[:, i])[k - 1]
            v = np.sort(X1[:, j])[k - 1]
            ltd = (
                np.sum(np.where(np.logical_and(X1[:, i] <= u, X1[:, j] <= v), 1, 0)) / k
            )

            mat[i, j] = ltd
            mat[j, i] = mat[i, j]

        for i in range(0, n):
            u = np.sort(X1[:, i])[k - 1]
            v = np.sort(X1[:, i])[k - 1]
            ltd = (
                np.sum(np.where(np.logical_and(X1[:, i] <= u, X1[:, i] <= v), 1, 0)) / k
            )

            mat[i, i] = ltd

    mat = np.clip(np.round(mat, 8), a_min=1.0e-8, a_max=1)

    if flag:
        mat = pd.DataFrame(mat, index=cols, columns=cols)
    else:
        mat = pd.DataFrame(mat)

    return mat""" ;
    rf:content_hash "149cdb887d682365dfc9d9c9d366297743ba8786582764d95836a0db27b5272e" ;
    rf:line_end 675 ;
    rf:line_start 642 ;
