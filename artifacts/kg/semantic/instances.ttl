        if a is not None:
            if a.shape[0] == n and a.shape[1] == 1:
                a = a
            else:
                raise NameError("Weights must have a size of shape (n_assets,1).")
        else:
            a = np.array(np.ones((n, 1)) / n)
        self._benchweights = a

