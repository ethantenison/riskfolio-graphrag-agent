display(Y.head())""" ;
    rf:content_hash "472e62abbb29d5b7ae55da362e0128815838172237be1cb17b2576032bc0a0e4" ;
    rf:line_end 3 ;
    rf:line_start 3 ;
    rf:relative_path "Tutorial 40 - Mean Relativistic Value at Risk (RLVaR) Optimization.ipynb" ;
    rf:section "example_cell" ;
