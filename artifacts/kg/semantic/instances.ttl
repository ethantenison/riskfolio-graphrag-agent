    rf:section "_naive_risk" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/HCPortfolio.py" .

<https://riskfolio-graphrag.io/kg/v2/HCPortfolio.py::chunk:59> a rf:Chunk ;
    rf:chunk_index 59 ;
    rf:chunk_kind "function" ;
    rf:content """kappa_g=self.kappa_g,
                        solver=self.solver_rl,
                    )
                else:
                    risk = rk.Sharpe_Risk(
                        returns=returns,
                        w=w,
                        cov=cov,
                        rm=rm,
                        rf=rf,
                        alpha=self.alpha,
                        a_sim=self.a_sim,
                        beta=self.beta,
                        b_sim=self.b_sim,
                        kappa=self.kappa,
                        kappa_g=self.kappa_g,
                        solver=self.solver_rl,
                    )
                inv_risk[k, 0] = risk

            if rm == "MV":
                inv_risk = 1 / np.power(inv_risk, 2)
            else:
                inv_risk = 1 / inv_risk
            weights = inv_risk * (1 / np.sum(inv_risk))

        weights = weights.reshape(-1, 1)

        return weights""" ;
