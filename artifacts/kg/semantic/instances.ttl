    rf:content """shold * sd_vec[j])
                ) or (
                    (X1[k, i] <= -threshold * sd_vec[i])
                    and (X1[k, j] >= threshold * sd_vec[j])
                ):
                    neg += 1

            # Compute Gerber correlation matrix
            corr[i, j] = (pos - neg) / (pos + neg)
