    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:23> a rf:Chunk ;
    rf:chunk_index 23 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Building The Loadings Matrix
########################################################################

a = np.identity(len(cols))
a = pd.DataFrame(a, index=cols, columns=cols)
loadings = pd.concat([a, loadings], axis = 1)
loadings.fillna(0, inplace=True)

display(loadings.style.format("{:.4f}").background_gradient(cmap='YlGn'))""" ;
    rf:content_hash "64a59c1ae3c112e724383a0b8cd0658300b46faa041cfb01e17218a9d912a339" ;
