<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:65> a rf:Chunk ;
    rf:chunk_index 65 ;
    rf:chunk_kind "function" ;
    rf:content """def NEA(w):
    r\"\"\"
    Calculate the number of effective assets (NEA) that is the inverse of the
    Herfindahl Hirschman index (HHI).

    Parameters
    ----------
    w : DataFrame or Series of shape (n_assets, 1)
        Portfolio weights, where n_assets is the number of assets.

    Raises
    ------
    ValueError
        When the value cannot be calculated.

    Returns
    -------
    value : float
        The NEA of the portfolio.
    \"\"\"

    a = np.array(w, ndmin=2)
    if a.shape[0] == 1 and a.shape[1] > 1:
        a = a.T
    if a.shape[0] > 1 and a.shape[1] > 1:
        raise ValueError("w must have n_assets x 1 size")

    value = 1 / np.sum(a**2)

    return value""" ;
    rf:content_hash "73d9348d2986af60dcedfd8443ecf8145ff88e1b9fca031c33779f4f0b488a58" ;
    rf:line_end 1925 ;
