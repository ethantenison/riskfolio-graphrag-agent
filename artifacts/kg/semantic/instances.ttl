<https://riskfolio-graphrag.io/kg/v2/Tutorial%2029%20-%20Hierarchical%20Risk%20Parity%20(HRP)%20Portfolio%20Optimization%20with%20Constraints.ipynb::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import numpy as np
import pandas as pd
import yfinance as yf
import warnings

warnings.filterwarnings("ignore")
pd.options.display.float_format = '{:.4%}'.format

# Date range
start = '2016-01-01'
end = '2019-12-30'

# Tickers of assets
assets = ['JCI', 'TGT', 'CMCSA', 'CPB', 'MO', 'APA', 'MMC', 'JPM',
          'ZION', 'PSA', 'BAX', 'BMY', 'LUV', 'PCAR', 'TXT', 'TMO',
          'DE', 'MSFT', 'HPQ', 'SEE', 'VZ', 'CNP', 'NI', 'T', 'BA']
assets.sort()

# Downloading data
data = yf.download(assets, start = start, end = end, auto_adjust=False)
data = data.loc[:,('Adj Close', slice(None))]
data.columns = assets""" ;
    rf:content_hash "36c7e0da23da1fcc1875d7cb34cd7e1a734f5f0d628084e32f672fed8d5ee76a" ;
    rf:line_end 2 ;
    rf:line_start 2 ;
    rf:relative_path "Tutorial 29 - Hierarchical Risk Parity (HRP) Portfolio Optimization with Constraints.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 29 - Hierarchical Risk Parity (HRP) Portfolio Optimization with Constraints.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2029%20-%20Hierarchical%20Risk%20Parity%20(HRP)%20Portfolio%20Optimization%20with%20Constraints.ipynb::chunk:3> a rf:Chunk ;
    rf:chunk_index 3 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Calculating returns

Y = data[assets].pct_change().dropna()

display(Y.head())""" ;
    rf:content_hash "9412fe9239d1803617a3473e9a1f9abb2933381c560861b2e1289c47e85d07b2" ;
    rf:line_end 3 ;
