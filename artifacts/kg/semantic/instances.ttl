<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:9> a rf:Chunk ;
    rf:chunk_index 9 ;
    rf:chunk_kind "function" ;
    rf:content """h Lower Partial Moment of a returns series.

    \"\"\"

    a = np.array(X, ndmin=2)
    if a.shape[0] == 1 and a.shape[1] > 1:
        a = a.T
    if a.shape[0] > 1 and a.shape[1] > 1:
        raise ValueError("returns must have Tx1 size")
    if p not in [1, 2]:
        raise ValueError("p can only be 1 or 2")

    value = MAR - a

    if p == 2:
        n = value.shape[0] - 1
    else:
        n = value.shape[0]

    value = np.sum(np.power(value[np.where(value >= 0)], p)) / n
    value = np.power(value, 1 / p).item()

    return value""" ;
