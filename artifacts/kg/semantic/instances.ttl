    rf:content """## 2. Estimating Mean Variance Portfolios

### 2.1 Calculating the portfolio that minimizes Variance.""" ;
    rf:content_hash "d327721a4619208a870b503d6272a92c514863baa776ef1b312789f13e77ec09" ;
    rf:line_end 4 ;
    rf:line_start 4 ;
    rf:relative_path "Tutorial 34 - Comparing Covariance Estimators Methods.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 34 - Comparing Covariance Estimators Methods.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2034%20-%20Comparing%20Covariance%20Estimators%20Methods.ipynb::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import riskfolio as rp

# Building the portfolio object
port = rp.Portfolio(returns=Y)

# Calculating optimal portfolio

# Select method and estimate input parameters:

method_mu='hist' # Method to estimate expected returns based on historical data.
method_covs = ['hist', 'ledoit', 'oas', 'shrunk', 'gl', 'ewma1',
               'ewma2','jlogo', 'fixed', 'spectral', 'shrink',
               'gerber1', 'gerber2']

# Estimate optimal portfolio:

model='Classic' # Could be Classic (historical), BL (Black Litterman) or FM (Factor Model)
rm = 'MV' # Risk measure used, this time will be variance
obj = 'MinRisk' # Objective function, could be MinRisk, MaxRet, Utility or Sharpe
hist = True # Use historical scenarios for risk measures that depend on scenarios
rf = 0 # Risk free rate
l = 0 # Risk aversion factor, only useful when obj is 'Utility'

w_s = pd.DataFrame([])

for i in method_covs:
    port.assets_stats(method_mu=method_mu, method_cov=i)
    w = port.optimization(model=model, rm=rm, ob""" ;
    rf:content_hash "c095aefd2f49f903dfb3ed0ac2796cb224ad61bbc32422f54996bdc683c71d35" ;
    rf:line_end 5 ;
    rf:line_start 5 ;
    rf:relative_path "Tutorial 34 - Comparing Covariance Estimators Methods.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 34 - Comparing Covariance Estimators Methods.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2034%20-%20Comparing%20Covariance%20Estimators%20Methods.ipynb::chunk:6> a rf:Chunk ;
    rf:chunk_index 6 ;
    rf:chunk_kind "example_cell" ;
    rf:content """ort.assets_stats(method_mu=method_mu, method_cov=i)
    w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)
    w_s = pd.concat([w_s, w], axis=1)
    
w_s.columns = method_covs""" ;
    rf:content_hash "69fcdd60920f2cea309dca925881a0a774537c6194fc987294232a327043e0b4" ;
    rf:line_end 5 ;
    rf:line_start 5 ;
