ax = rp.plot_frontier_area(w_frontier=frontier, cmap="tab20", height=6, width=10, ax=None)""" ;
    rf:content_hash "a78125ffb0c2dce5951f0229e042b94e7a0cfff8ebb93b420c00808453bc2836" ;
    rf:line_end 15 ;
