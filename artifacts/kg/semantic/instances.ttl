                        custom_cov=custom_cov,
                        codependence='custom_cov',
                        linkage='ward',
                        k=None,
                        max_k=10,
                        leaf_order=True,
                        ax=None)""" ;
    rf:content_hash "1bd0a30f739a2dce1bb660ce85476c8539b59dac306fae16e95ffe4d16dd39c9" ;
