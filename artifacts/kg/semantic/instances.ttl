    rf:content """hild[m]))

            del DirectChild, TempVec

        Root = np.unique(NxtRoot)

    Nb = Mb.shape[1]
    H = np.zeros((Nb, Nb))

    # if sum(IdentifyJoint==0)==0;
    for n in range(0, Nb):
        Indx = Mb[:, n] == 1
        JointSum = np.sum(Mb[Indx, :], axis=0)
        Neigh = JointSum >= 1
        H[n, Neigh] = 1
    # else
    #     H=[];

    H = H + H.T
    H = H - np.diag(np.diag(H))

    return (H, Mb)""" ;
