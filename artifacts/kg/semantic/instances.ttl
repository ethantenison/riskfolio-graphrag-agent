<https://riskfolio-graphrag.io/kg/v2/Tutorial%203%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman.ipynb::chunk:14> a rf:Chunk ;
    rf:chunk_index 14 ;
    rf:chunk_kind "example_cell" ;
    rf:content """points = 50 # Number of points of the frontier

frontier = port.efficient_frontier(model=model, rm=rm, points=points, rf=rf, hist=hist)

display(frontier.T.head())""" ;
    rf:content_hash "2a30beb94f52fd3c66b8855148bcd9ae857ac574a648123b91fdf341ce4deff1" ;
    rf:line_end 13 ;
    rf:line_start 13 ;
    rf:relative_path "Tutorial 3 - Mean Risk Optimization using Black Litterman.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 3 - Mean Risk Optimization using Black Litterman.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%203%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman.ipynb::chunk:15> a rf:Chunk ;
    rf:chunk_index 15 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Plotting the efficient frontier

label = 'Max Risk Adjusted Return Portfolio' # Title of point
mu = port.mu_bl # Expected returns of Black Litterman model
cov = port.cov_bl # Covariance matrix of Black Litterman model
returns = port.returns # Returns of the assets

ax = rp.plot_frontier(w_frontier=frontier, mu=mu, cov=cov, returns=returns, rm=rm,
                      rf=rf, alpha=0.05, cmap='viridis', w=w_bl, label=label,
                      marker='*', s=16, c='r', height=6, width=10, ax=None)""" ;
    rf:content_hash "4763272d0d2dad8ca7576c0e84c1a9b42cc7df989064e1b55af8f49e3533fb7e" ;
