<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:32> a rf:Chunk ;
    rf:chunk_index 32 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Estimating optimum portfolio with key rate durations constraints
########################################################################

C, D = rp.factors_constraints(constraints, loadings)

port.ainequality = C
port.binequality = D

w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)

display(w.style.format("{:.4%}").background_gradient(cmap='YlGn'))""" ;
