<https://riskfolio-graphrag.io/kg/v2/Tutorial%2046%20-%20Classic%20Mean%20Risk%20Optimization%20with%20Network%20and%20Dendrogram%20Constraints.ipynb::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import numpy as np
import pandas as pd
import yfinance as yf
import warnings

warnings.filterwarnings("ignore")
pd.options.display.float_format = '{:.4%}'.format

# Date range
start = '2016-01-01'
end = '2019-12-30'

# Tickers of assets
assets = ['JCI', 'TGT', 'CMCSA', 'CPB', 'MO', 'APA', 'MMC', 'JPM',
          'ZION', 'PSA', 'BAX', 'BMY', 'LUV', 'PCAR', 'TXT', 'TMO',
          'DE', 'MSFT', 'HPQ', 'SEE', 'VZ', 'CNP', 'NI', 'T', 'BA']
assets.sort()

# Downloading data
data = yf.download(assets, start = start, end = end, auto_adjust=False)
data = data.loc[:,('Adj Close', slice(None))]
data.columns = assets""" ;
    rf:content_hash "c4c24c9e0af482d4305adadc61f53e512e9cd87259ed3fdfb3e01f7e27ca3ac1" ;
    rf:line_end 2 ;
    rf:line_start 2 ;
    rf:relative_path "Tutorial 46 - Classic Mean Risk Optimization with Network and Dendrogram Constraints.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 46 - Classic Mean Risk Optimization with Network and Dendrogram Constraints.ipynb" .

