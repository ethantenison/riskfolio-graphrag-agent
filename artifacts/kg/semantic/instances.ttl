    rf:chunk_kind "test_function" ;
    rf:content """def test_classic_minrisk_optimization():

    Y = get_data("stock_prices.csv")
    Y = Y[assets].pct_change().dropna().iloc[-200:]

    port = rp.Portfolio(returns=Y)

    method_mu = "hist"
    method_cov = "hist"

    port.assets_stats(method_mu=method_mu, method_cov=method_cov, d=0.94)
    port.alpha = 0.05
    port.solvers = ['CLARABEL', 'SCS', 'ECOS']

    model = "Classic"
    obj = "MinRisk"
    hist = True
    rf = 0
    l = 0

    rms = [
        "MV",
        "MAD",
        "GMD",
        "MSV",
        "FLPM",
        "SLPM",
        "CVaR",
        "TG",
        "EVaR",
        "WR",
        "RG",
        "CVRG",
        "TGRG",
        "MDD",
        "ADD",
        "CDaR",
        "EDaR",
        "UCI",
    ]

    w_1 = pd.DataFrame([])

    for i in rms:
        w = port.optimization(model=model, rm=i, obj=obj, rf=rf, l=l, hist=hist)
        w_1 = pd.concat([w_1, w], axis=1)

    w_1.columns = rms
    # w_1.to_csv("Classic_MinRisk.csv")

    w_2 = get_data("Classic_MinRis""" ;
