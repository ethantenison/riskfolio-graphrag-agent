<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:30> a rf:Chunk ;
    rf:chunk_index 30 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Creating key rate durations constraints
########################################################################

constraints = {'Disabled': [False, False, False],
               'Factor': ['R 1800', 'R 3600', 'R 7200'],
               'Sign': ['<=', '<=', '<='],
               'Value': [-2, -2, -3],
               'Relative Factor': ['', '', '']}

constraints = pd.DataFrame(constraints)

display(constraints)""" ;
