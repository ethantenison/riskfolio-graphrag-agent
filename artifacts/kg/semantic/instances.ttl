<https://riskfolio-graphrag.io/kg/v2/Tutorial%2044%20-%20Hierarchical%20Equal%20Risk%20Contribution%20(HERC)%20Portfolio%20Optimization%20with%20Constraints.ipynb::chunk:4> a rf:Chunk ;
    rf:chunk_index 4 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import riskfolio as rp

# Plotting Assets Clusters

ax = rp.plot_clusters(returns=Y,
                      codependence='pearson',
                      linkage='ward',
                      k=None,
                      max_k=10,
                      leaf_order=True,
                      dendrogram=True,
                      #linecolor='tab:purple',
                      ax=None)""" ;
    rf:content_hash "1b43f0178ce622e97bf8e1552b46ac6af63e66e83f658dd6d5b203bebe676186" ;
