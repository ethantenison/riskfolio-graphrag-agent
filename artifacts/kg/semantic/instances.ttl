<https://riskfolio-graphrag.io/kg/v2/Tutorial%2045%20-%20Nested%20Clustered%20Optimization%20(NCO)%20Portfolio%20Optimization%20with%20Constraints.ipynb::chunk:4> a rf:Chunk ;
    rf:chunk_index 4 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import riskfolio as rp

# Plotting Assets Clusters

ax = rp.plot_clusters(returns=Y,
                      codependence='pearson',
                      linkage='ward',
                      k=None,
                      max_k=10,
                      leaf_order=True,
                      dendrogram=True,
                      #linecolor='tab:purple',
                      ax=None)""" ;
    rf:content_hash "30bc5aae114fef70c12eb6fa1cf2020bbc3d4cf11be122bcfe23ee82ae7d6edb" ;
