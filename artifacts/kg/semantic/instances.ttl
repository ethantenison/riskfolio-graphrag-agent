    rf:content """p) @ (B1.T * std.T)).T

            B2 = pinv(B1.T)
            N_f = B2.shape[1]
            w1 = cp.Variable((N_f, 1))
            w = B2 @ w1

            if b_f is None:
                rb = np.ones((N_f, 1))
                rb = rb / N_f
            else:
                self.b_f = b_f.copy()
                rb = self.b_f
        else:
            w = cp.Variable((N, 1))
            if b is None:
                rb = np.ones((N, 1))
                rb = rb / N
            else:
                self.b = b.copy()
                rb = self.b

        k = cp.Variable((1, 1))
        rf0 = rf
        ret = mu @ w

        constraints = []

        # MV Model Variables

        g = cp.Variable(nonneg=True)
        G = sqrtm(sigma)
        risk1 = g**2
        devconstraints = [cp.SOC(g, G.T @ w)]

        # MAD Model Variables

        Y = cp.Variable((T, 1))
        u = np.repeat(mu, T, axis=0)
        a = returns - u
        risk2 = cp.sum(Y) / T
        # madconstraints=[a @ w >= -Y,""" ;
