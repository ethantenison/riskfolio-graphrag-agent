<https://riskfolio-graphrag.io/kg/v2/Portfolio.py::chunk:337> a rf:Chunk ;
    rf:chunk_index 337 ;
    rf:chunk_kind "function" ;
    rf:content """def wc_stats(
        self,
        box="s",
        ellip="s",
        q=0.05,
        n_sim=3000,
        window=3,
        diag=False,
        threshold=1e-15,
        dmu=0.1,
        dcov=0.1,
        method_k_mu="normal",
        method_k_sigma="normal",
        seed=0,
    ):
        r\"\"\"
        Calculate the inputs that will be used by the wc_optimization method.

        Parameters
        ----------
        box : string
            The method used to estimate the box uncertainty sets. The default is 's'. Possible values are:

            - 's': stationary bootstrapping method.
            - 'c': circular bootstrapping method.
            - 'm': moving bootstrapping method.
            - 'n': assuming normal returns to calculate confidence levels.
            - 'd': delta method, this method increase and decrease by a percentage.

        ellip : string
            The method used to estimate the elliptical uncertainty sets. The default is 's'. Possible values are:""" ;
    rf:content_hash "58b4ef96d6f245f81d39df8ab7c29b58428509f70a4f5bc6e309d6cfd9b50383" ;
    rf:line_end 1731 ;
    rf:line_start 1709 ;
    rf:relative_path "Portfolio.py" ;
    rf:section "wc_stats" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/Portfolio.py" .

<https://riskfolio-graphrag.io/kg/v2/Portfolio.py::chunk:338> a rf:Chunk ;
    rf:chunk_index 338 ;
    rf:chunk_kind "function" ;
    rf:content """sed to estimate the elliptical uncertainty sets. The default is 's'. Possible values are:

            - 's': stationary bootstrapping method.
            - 'c': circular bootstrapping method.
            - 'm': moving bootstrapping method.
            - 'n': assuming normal returns to calculate confidence levels.

        q : scalar
            Significance level of the selected bootstrapping method.
            The default is 0.05.
        n_sim : scalar
            Number of simulations of the bootstrapping method.
            The default is 3000.
        window:
            Block size of the bootstrapping method. Must be greather than 1
            and lower than the n_samples - n_features + 1
            The default is 3.
        diag: bool
            If consider only the main diagonal of covariance matrices of estimation
            errors following :cite:`a-fabozzi2007robust`. The default is False.
        threshold: float
            Parameter used to fix covariance matrices i""" ;
    rf:content_hash "077444b56afc584e515ec8a4edb2dc32226fa4e8531bdb97cd2f1c3c5334ba09" ;
