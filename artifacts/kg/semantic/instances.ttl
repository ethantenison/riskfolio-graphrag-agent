<https://riskfolio-graphrag.io/kg/v2/Tutorial%209%20-%20Portfolio%20Optimization%20using%20Risk%20Factors%20and%20Principal%20Components%20Regression%20(PCR).ipynb::chunk:16> a rf:Chunk ;
    rf:chunk_index 16 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Risk Measures available:
#
# 'MV': Standard Deviation.
# 'MAD': Mean Absolute Deviation.
# 'MSV': Semi Standard Deviation.
# 'FLPM': First Lower Partial Moment (Omega Ratio).
# 'SLPM': Second Lower Partial Moment (Sortino Ratio).
# 'CVaR': Conditional Value at Risk.
# 'EVaR': Entropic Value at Risk.
# 'WR': Worst Realization (Minimax)
# 'MDD': Maximum Drawdown of uncompounded cumulative returns (Calmar Ratio).
# 'ADD': Average Drawdown of uncompounded cumulative returns.
# 'CDaR': Conditional Drawdown at Risk of uncompounded cumulative returns.
# 'EDaR': Entropic Drawdown at Risk of uncompounded cumulative returns.
# 'UCI': Ulcer Index of uncompounded cumulative returns.

rms = ['MV', 'MAD', 'MSV', 'FLPM', 'SLPM', 'CVaR',
       'EVaR', 'WR', 'MDD', 'ADD', 'CDaR', 'UCI', 'EDaR']

w_s = pd.DataFrame([])

# When we use hist = True the risk measures all calculated
# using historical returns, while when hist = False the
# risk measures are calculated using the expected returns 
#  based""" ;
    rf:content_hash "772a924a2a2c76b3eaf45b2b452d01fa2d844cb7d2cf1a54a5b6a5a7238c3984" ;
    rf:line_end 15 ;
    rf:line_start 15 ;
    rf:relative_path "Tutorial 9 - Portfolio Optimization using Risk Factors and Principal Components Regression (PCR).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 9 - Portfolio Optimization using Risk Factors and Principal Components Regression (PCR).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%209%20-%20Portfolio%20Optimization%20using%20Risk%20Factors%20and%20Principal%20Components%20Regression%20(PCR).ipynb::chunk:17> a rf:Chunk ;
    rf:chunk_index 17 ;
    rf:chunk_kind "example_cell" ;
    rf:content """ns, while when hist = False the
# risk measures are calculated using the expected returns 
#  based on risk factor model: R = a + B * F

hist = False

for i in rms:
    w = port.optimization(model=model, rm=i, obj=obj, rf=rf, l=l, hist=hist)
    w_s = pd.concat([w_s, w], axis=1)
    
w_s.columns = rms""" ;
