    rf:chunk_index 14 ;
    rf:chunk_kind "example_cell" ;
    rf:content """dence=codependence,
                          method_cov=method_cov,
                          obj=obj,
                          rm=i,
                          rf=rf,
                          linkage=linkage,
                          max_k=max_k,
                          leaf_order=leaf_order)

    w_s = pd.concat([w_s, w], axis=1)
    
w_s.columns = rms""" ;
