<https://riskfolio-graphrag.io/kg/v2/Tutorial%2028%20-%20Hierarchical%20Clustering%20and%20Networks.ipynb::chunk:10> a rf:Chunk ;
    rf:chunk_index 10 ;
    rf:chunk_kind "example_section" ;
    rf:content """## 5. Comparing Networks Layouts 

Sometimes it is better to plot a network using a specific layout. Changing the network layout could help us to visualize better the relationship among assets and to identify a better clustering method. Riskfolio-Lib offers four network layouts.""" ;
    rf:content_hash "1067588a30a35373c8c50f07ba94120da62ed98edfa1829d4c1b29225d66244a" ;
    rf:line_end 10 ;
    rf:line_start 10 ;
    rf:relative_path "Tutorial 28 - Hierarchical Clustering and Networks.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 28 - Hierarchical Clustering and Networks.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2028%20-%20Hierarchical%20Clustering%20and%20Networks.ipynb::chunk:11> a rf:Chunk ;
    rf:chunk_index 11 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Comparison of several network layouts

kinds =['spring','kamada','planar','circular']

fig, ax = plt.subplots(len(kinds), 1, figsize=(12, 30))
ax = np.ravel(ax)

j = 0
for i in kinds:
    ax[j] = rp.plot_network(returns=Y,
                            codependence="pearson",
                            linkage="DBHT",
                            k=None,
                            max_k=10,
                            leaf_order=True,
                            kind=i,
                            seed=0,
                            ax=ax[j])
    j += 1
    
plt.plot()""" ;
    rf:content_hash "4fd6adfa458dd1f0e85a462ded9b58b6a193b1bd82e910f673c1e44432e86c3b" ;
    rf:line_end 11 ;
    rf:line_start 11 ;
