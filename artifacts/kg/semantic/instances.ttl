<https://riskfolio-graphrag.io/kg/v2/Tutorial%2052%20-%20Portfolio%20Optimization%20with%20Integer%20Constraints.ipynb::chunk:10> a rf:Chunk ;
    rf:chunk_index 10 ;
    rf:chunk_kind "example_section" ;
    rf:content """## 3. Estimating Mean Variance Portfolios with Integer Constraints

### 3.1 Upper Bound on the Maximum Number of Assets""" ;
    rf:content_hash "c07641e46c27471d0b080952449318c49bb32eee62a061572af7c801ba87e10b" ;
    rf:line_end 9 ;
    rf:line_start 9 ;
    rf:relative_path "Tutorial 52 - Portfolio Optimization with Integer Constraints.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 52 - Portfolio Optimization with Integer Constraints.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2052%20-%20Portfolio%20Optimization%20with%20Integer%20Constraints.ipynb::chunk:11> a rf:Chunk ;
    rf:chunk_index 11 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Upper bound on the maximum number of assets
constraints = {'Disabled': [False],
               'Type': ['Assets'],
               'Set': [''],
               'Position': [''],
               'Kind': ['CardUp'],
               'Value': [8.0],
               'Type Relative': [''],
               'Relative Set': [''],
               'Relative': ['']}

constraints = pd.DataFrame(constraints)

A, B, C, D, E, F = rp.integer_constraints(constraints, asset_classes)

# First we need to set a solver that support Mixed Integer Programming
port.solvers = ['MOSEK']

# Then we need to set the integer constraint
port.aintinequality = A
port.bintinequality = B
port.cintinequality = C
port.dintinequality = D
port.eintinequality = E
port.fintinequality = F

# Optionally, we can set the minimum weight of assets
port.lowerlng = 0.02

w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)

display(w.T)""" ;
    rf:content_hash "423fe78061c3acad003052e451f8a73a4a1c2000c96b8ef5001985d6d70b195c" ;
    rf:line_end 10 ;
    rf:line_start 10 ;
