<https://riskfolio-graphrag.io/kg/v2/Portfolio.py::chunk:515> a rf:Chunk ;
    rf:chunk_index 515 ;
    rf:chunk_kind "function" ;
    rf:content """def reset_all(self):
        r\"\"\"
        Reset portfolio object to defatult values.

        \"\"\"

        self.sht = False
        self.uppersht = 0.2
        self.upperlng = 1
        self.budget = 1
        self.budgetsh = 0.2
        self.nea = None
        self.card = None
        self._factors = None
        self.B = None
        self.alpha = 0.05
        self.a_sim = 100
        self.beta = None
        self.b_sim = None
        self.kappa = 0.30
        self.kappa_g = None
        self.n_max_kurt = 50
        self.kindbench = True
        self.benchindex = None
        self.benchweights = None
        self.allowTO = False
        self.turnover = 0.05
        self.allowTE = False
        self.TE = 0.05

        self.reset_risk_constraints()
        self.reset_linear_constraints()
        self.reset_inputs()""" ;
