    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:27> a rf:Chunk ;
    rf:chunk_index 27 ;
    rf:chunk_kind "example_section" ;
    rf:content """## 5. Optimization of Equity and Bond Portfolio with Key Rate Durations Constraints

This part shows how __Riskfolio-Lib__ can be used to build immunized portfolios using __duration matching__ and __convexity matching__, however the example only use duration matching. More information about immunization theory can be found in this __[link](https://www.investopedia.com/terms/i/immunization.asp)__.

### 5.1 Statistics of Risk Factors""" ;
    rf:content_hash "7f601b4b00083dbc4eca32e67012114314f32f880ff07f5926fe6041b13a3a15" ;
    rf:line_end 24 ;
    rf:line_start 24 ;
