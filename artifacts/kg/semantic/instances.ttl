<https://riskfolio-graphrag.io/kg/v2/Tutorial%201%20-%20Classic%20Mean%20Risk%20Optimization.ipynb::chunk:20> a rf:Chunk ;
    rf:chunk_index 20 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 3.4 Calculate Optimal Portfolios for Several Risk Measures" ;
    rf:content_hash "5c6c3dd3af156425a43b7837a2ec6423e7f22ac3a5bba6bfc722eeaf49d333c5" ;
    rf:line_end 20 ;
    rf:line_start 20 ;
    rf:relative_path "Tutorial 1 - Classic Mean Risk Optimization.ipynb" ;
