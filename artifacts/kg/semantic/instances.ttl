<https://riskfolio-graphrag.io/kg/v2/PlotFunctions.py::chunk:65> a rf:Chunk ;
    rf:chunk_index 65 ;
    rf:chunk_kind "function" ;
    rf:content """ax.set_yticks(ax.get_yticks())
    ax.set_yticklabels(["{:3.4%}".format(x) for x in ticks_loc])
    ax.grid(linestyle=":")

    if erc_line:
        if percentage:
            erc = 1 / len(RC_F)
        else:
            erc = rk.Sharpe_Risk(
                returns=returns,
                w=w_,
                cov=cov,
                rm=rm,
                rf=rf,
                alpha=alpha,
                a_sim=a_sim,
                beta=beta,
                b_sim=b_sim,
                kappa=kappa,
                solver=solver,
            )

            if rm not in ["MDD", "ADD", "CDaR", "EDaR", "RLDaR", "UCI"]:
                erc = erc / len(RC_F) * t_factor**0.5
            else:
                erc = erc / len(RC_F)

        ax.axhline(y=erc, color=erc_linecolor, linestyle="-")

    try:
        fig.set_layout_engine(layout="constrained")
    except:
        pass

    return ax""" ;
    rf:content_hash "4843f897e31538cf9803bca0189e92cda57d905d6254f5853cba8d1b71108502" ;
