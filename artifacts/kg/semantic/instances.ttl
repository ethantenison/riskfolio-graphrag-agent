<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:12> a rf:Chunk ;
    rf:chunk_index 12 ;
    rf:chunk_kind "function" ;
    rf:content """def _Entropic_RM(z, X, alpha=0.05):
    a = np.array(X, ndmin=2)
    if a.shape[0] == 1 and a.shape[1] > 1:
        a = a.T
    if a.shape[0] > 1 and a.shape[1] > 1:
        raise ValueError("returns must have Tx1 size")

    a = a.flatten()
    value = np.mean(np.exp(-1 / z * a), axis=0)
    value = z * (np.log(value) + np.log(1 / alpha))
    value = np.array(value).item()

    return value""" ;
    rf:content_hash "b0dc951a4abcc3be967f35c95eec0f29390f647f63c8b15814371ffc6827edb6" ;
    rf:line_end 461 ;
    rf:line_start 449 ;
    rf:relative_path "RiskFunctions.py" ;
    rf:section "_Entropic_RM" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/RiskFunctions.py" .

