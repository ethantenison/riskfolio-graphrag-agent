    def _opt_w(
        self,
        returns,
        mu,
        cov,
        obj="MinRisk",
        rm="MV",
        rf=0,
        l=2,
    ):
        if returns.shape[1] == 1:
            weights = np.array([1]).reshape(-1, 1)
        else:
            if obj in {"MinRisk", "Utility", "Sharpe"}:
                port = rp.Portfolio(
                    returns=returns,
                    alpha=self.alpha,
                    a_sim=self.a_sim,
                    beta=self.beta,
                    b_sim=self.b_sim,
                    kappa=self.kappa,
                    kappa_g=self.kappa_g,
                )

                if self.kurt:
                    method_kurt = "hist"
                elif self.skurt:
                    method_kurt = "semi"
                else:
                    method_kurt = None

                port.assets_stats(
                    method_mu="hist", method_cov="hist", method_kurt=method_kurt
                )""" ;
