    try:
        for solver_i in solvers:
            prob.solve(solver=solver_i)
            if risk.value is not None:
                break
    except:
        pass

    if risk.value is None:
        value = None
    else:
        value = risk.value.item()

    if value is None:
        # Primal Formulation
        t = cp.Variable((1, 1))
        z = cp.Variable((1, 1))
        omega = cp.Variable((T, 1))
        psi = cp.Variable((T, 1))
        theta = cp.Variable((T, 1))
        nu = cp.Variable((T, 1))

        ones = np.ones((T, 1))
        constraints = [
            cp.PowCone3D(
                z * (1 + kappa) / (2 * kappa) * ones,
                psi * (1 + kappa) / kappa,
                nu,
