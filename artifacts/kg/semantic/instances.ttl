<https://riskfolio-graphrag.io/kg/v2/Tutorial%2021%20-%20Constraints%20on%20Return%20and%20Risk%20Measures.ipynb::chunk:10> a rf:Chunk ;
    rf:chunk_index 10 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Plotting the efficient frontier in Std. Dev. dimension

label = 'Max Risk Adjusted Return Portfolio' # Title of point
mu = port.mu # Expected returns
cov = port.cov # Covariance matrix
returns = port.returns # Returns of the assets

ax = rp.plot_frontier(w_frontier=frontier, mu=mu, cov=cov, returns=returns, rm=rm,
                      rf=rf, alpha=0.05, cmap='viridis', w=w, label=label,
                      marker='*', s=16, c='r', height=6, width=10, ax=None)""" ;
    rf:content_hash "fa7e2cc3f0850183eca25a9486b2a52131bdc06141af2e88b9c1588d6ab67d9e" ;
    rf:line_end 10 ;
    rf:line_start 10 ;
    rf:relative_path "Tutorial 21 - Constraints on Return and Risk Measures.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 21 - Constraints on Return and Risk Measures.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2021%20-%20Constraints%20on%20Return%20and%20Risk%20Measures.ipynb::chunk:11> a rf:Chunk ;
    rf:chunk_index 11 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Plotting the efficient frontier in CVaR dimension

ax = rp.plot_frontier(w_frontier=frontier, mu=mu, cov=cov, returns=returns, rm='CVaR',
                      rf=rf, alpha=0.05, cmap='viridis', w=w, label=label,
                      marker='*', s=16, c='r', height=6, width=10, ax=None)""" ;
    rf:content_hash "1947156025db0582aef181acbac61d79f29634019d5ce462af09ca5cf3d19a8f" ;
