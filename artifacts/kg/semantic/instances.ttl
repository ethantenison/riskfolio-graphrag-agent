        + "{0:.2%}".format(risk[4]),
        "{0:.2%}".format((1 - alpha))
        + " Confidence RLDaR ("
        + "{0:.3}".format(kappa)
        + "): "
        + "{0:.2%}".format(risk[5]),
        "Maximum Drawdown: " + "{0:.2%}".format(risk[6]),
    ]
    color2 = ["b", "r", "fuchsia", "limegreen", "dodgerblue", "slateblue", "darkgrey"]

    j = 0

    ymin = np.min(DD) * 1.5

    locator = mdates.AutoDateLocator(minticks=5, maxticks=10)
    formatter = mdates.DateFormatter("%Y-%m")
    for i in axes:
        i.clea""" ;
