    rf:chunk_index 3 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Calculating returns

Y = data[assets].pct_change().dropna()

display(Y.head())""" ;
    rf:content_hash "1f952a28467200f4b949c2ddc215154659a013c431dae3536c1068a45e6a763a" ;
    rf:line_end 3 ;
    rf:line_start 3 ;
