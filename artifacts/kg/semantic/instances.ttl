    rf:content "## 2. Comparing Linkage Methods using Dendrograms and Two Difference Gap Statistic for Optimal Number of Clusters" ;
    rf:content_hash "ca6fc123a2aa6adf8f4c78eb3514575cde42321f3ffcc14ab676f4617430741c" ;
    rf:line_end 4 ;
    rf:line_start 4 ;
