    rf:section "loadings_matrix" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/ParamsEstimation.py" .

<https://riskfolio-graphrag.io/kg/v2/ParamsEstimation.py::chunk:35> a rf:Chunk ;
    rf:chunk_index 35 ;
    rf:chunk_kind "function" ;
    rf:content """"PCR":
            beta = PCR(X, Y[i], n_components=n_components)
            beta = pd.Series(np.ravel(beta), index=cols)
            loadings.loc[i, cols] = beta.T

    return loadings""" ;
