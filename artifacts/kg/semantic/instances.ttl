            )

        self.mu_bl_fm = mu
        self.cov_bl_fm = cov

        value = af.is_pos_def(self.cov_bl_fm, threshold=1e-6)
        for i in range(5):
            if value == False:
                try:
                    self.cov_bl_fm = af.cov_fix(
                        self.cov_bl_fm, method="clipped", threshold=1e-6
                    )
                    value = af.is_pos_def(self.cov_bl_fm, threshold=1e-6)
                except:
                    break
            else:
                break

        if value == False:
            print("You must convert self.cov_bl_fm to a positive definite matrix")

