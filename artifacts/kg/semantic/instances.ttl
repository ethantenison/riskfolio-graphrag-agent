                H[n, np.int32(Pred[n])] = 1
        if (Pred.shape[0] == 0) != 1:
            H = H + H.T
            H = H + Adj
        else:
            H = np.empty((0, 0))

    H1 = H.copy()

    if (H1.shape[0] == 0) != 1:
        H2, Mb = BubbleHierarchy(Pred, Sb, A, CliqList)
    else:
        H2 = np.empty((0, 0))
        Mb = np.empty((0, 0))

    H2 = 1.0 * (H2 != 0)
    Mb = Mb[0 : CliqList.shape[0], :]

    return (H1, H2, Mb, CliqList, Sb)""" ;
