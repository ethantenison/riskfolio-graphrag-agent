<https://riskfolio-graphrag.io/kg/v2/AuxFunctions.py::chunk:49> a rf:Chunk ;
    rf:chunk_index 49 ;
    rf:chunk_kind "function" ;
    rf:content """def round_values(data, decimals=4, wider=False):
    r\"\"\"
    This function help us to round values to values close or away from zero.

    Parameters
    ----------
    data : np.ndarray, pd.Series or pd.DataFrame
        Data that are going to be rounded.
    decimals : integer
        Number of decimals to round.
    wider : float
        False if round to values close to zero, True if round to values away
        from zero.

    Returns
    -------
    value : np.ndarray, pd.Series or pd.DataFrame
        Data rounded using selected method.

    Raises
    ------
    ValueError
        When the value cannot be calculated.

    \"\"\"

    if wider == True:
        value = np.where(
            data >= 0,
            np.ceil(data * 10**decimals) / 10**decimals,
            np.floor(data * 10**decimals) / 10**decimals,
        )
    elif wider == False:
        value = np.where(
            data >= 0,
            np.floor(data * 10**decimals) / 10**decimals,
            np.ceil(data * 1""" ;
    rf:content_hash "2d797fa2b5687def7fc6cf6ea6ce99f22fd9f9b0f7adec246c1bb47206374f25" ;
    rf:line_end 1325 ;
    rf:line_start 1290 ;
    rf:relative_path "AuxFunctions.py" ;
    rf:section "round_values" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/AuxFunctions.py" .

<https://riskfolio-graphrag.io/kg/v2/AuxFunctions.py::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
    rf:chunk_kind "function" ;
    rf:content """def cov_returns(cov, seed=0):
    r\"\"\"
    Generate a matrix of returns that have a covariance matrix cov.

    Parameters
    ----------
    cov : DataFrame of shape (n_assets, n_assets)
        Covariance matrix, where n_assets is the number of assets.

    Returns
    -------
    a : ndarray
        A matrix of returns that have a covariance matrix cov.

    Raises
    ------
        ValueError when the value cannot be calculated.

    \"\"\"

    rs = np.random.RandomState(seed)
    n = len(cov)
    a = np.array(rs.randn(n + 10, n), ndmin=2)

    for i in range(0, 5):
        cov_ = np.cov(a.T)
        L = np.array(np.linalg.cholesky(cov_), ndmin=2)
        a = a @ np.linalg.inv(L).T
        cov_ = np.cov(a.T)
        desv_ = np.sqrt(np.array(np.diag(cov_), ndmin=2))
        a = (np.array(a) - np.mean(a, axis=0)) / np.array(desv_)

    L1 = np.array(np.linalg.cholesky(cov), ndmin=2)
    a = a @ L1.T

    return a""" ;
    rf:content_hash "a1aa6f1314e8c00a93fe3aa713d647553c653ae53986b5ab8b940b5636af512d" ;
    rf:line_end 236 ;
    rf:line_start 201 ;
    rf:relative_path "AuxFunctions.py" ;
    rf:section "cov_returns" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/AuxFunctions.py" .

<https://riskfolio-graphrag.io/kg/v2/AuxFunctions.py::chunk:50> a rf:Chunk ;
    rf:chunk_index 50 ;
    rf:chunk_kind "function" ;
    rf:content """data >= 0,
