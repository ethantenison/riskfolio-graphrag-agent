<https://riskfolio-graphrag.io/kg/v2/DBHT.py::chunk:23> a rf:Chunk ;
    rf:chunk_index 23 ;
    rf:chunk_kind "function" ;
    rf:content """def clique3(A):
    r\"\"\"
    Computes the list of 3-cliques.

    Parameters
    ----------
    A : nd-array
        N x N sparse adjacency matrix.

    Returns
    -------
    clique : nd-array
        Nc x 3 matrix. Each row vector contains the list of vertices for
        a 3-clique.
    \"\"\"

    A = A - np.diag(np.diag(A))
    A = 1.0 * (A != 0)
    A2 = A @ A
    P = (1.0 * (A2 != 0)) * (1.0 * (A != 0))

    P = sp.csr_matrix(np.triu(P))

    r, c, _ = sp.find(P != 0)
    E = np.hstack((r.reshape(-1, 1), c.reshape(-1, 1)))

    K3 = {}
    N3 = np.zeros(len(r))
    for n in range(0, len(r)):
        i = r[n]
        j = c[n]
        a = A[i, :] * A[j, :]
        # indx = np.ravel(np.argwhere(a != 0))
        _, indx, _ = sp.find(a != 0)
        K3[n] = indx
        N3[n] = len(indx)

    clique = np.zeros((1, 3))
    for n in range(0, len(r)):
        temp = K3[n]
        for m in range(0, len(temp)):
            candidate = E[n, :]
            candidate = np.hstack((candidate, te""" ;
