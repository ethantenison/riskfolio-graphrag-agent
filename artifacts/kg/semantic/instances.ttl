<https://riskfolio-graphrag.io/kg/v2/PlotFunctions.py::chunk:187> a rf:Chunk ;
    rf:chunk_index 187 ;
    rf:chunk_kind "function" ;
    rf:content """_labels == True:
        nx.draw_networkx_labels(
            G, pos=labels_pos, labels=labels, ax=ax, bbox=label_options, **font_options
        )

    ax.set_yticks([])
    ax.set_yticklabels([])
    for i in {"right", "left", "top", "bottom"}:
        side = ax.spines[i]
        side.set_visible(False)

    if title == "":
        title = (
            "Clusters Network Asset Allocation ("
            + codependence.capitalize()
            + " & "
            + linkage
            + " linkage)"
        )

    ax.set_title(title)

    try:
        fig.set_layout_engine(layout="constrained")
    except:
        pass

    return ax""" ;
