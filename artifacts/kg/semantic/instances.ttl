    rf:chunk_index 22 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Building the asset returns matrix
########################################################################

Y = pd.concat([assets_returns[cols], Y], axis=1)

display(Y.head())""" ;
    rf:content_hash "bccffd8228ce2a7aab9523ba7e3323748fa726267d4318dca83908524bb302d6" ;
    rf:line_end 20 ;
    rf:line_start 20 ;
    rf:relative_path "Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" ;
