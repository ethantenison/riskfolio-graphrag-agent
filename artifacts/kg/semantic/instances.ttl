    rf:chunk_index 7 ;
    rf:chunk_kind "example_cell" ;
    rf:content """rf=rf,
                      l=l,
                      linkage=linkage,
                      max_k=max_k,
                      leaf_order=leaf_order)

display(w.T)""" ;
