<https://riskfolio-graphrag.io/kg/v2/Tutorial%2028%20-%20Hierarchical%20Clustering%20and%20Networks.ipynb::chunk:9> a rf:Chunk ;
    rf:chunk_index 9 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Comparison of two Network Graphs

linkages = ['ward','DBHT']

fig, ax = plt.subplots(len(linkages), 1, figsize=(12, 15))
ax = np.ravel(ax)

j = 0
for i in linkages:
    ax[j] = rp.plot_network(returns=Y,
                            codependence="pearson",
                            linkage=i,
                            opt_k_method="twodiff",
                            k=None,
                            max_k=10,
                            leaf_order=True,
                            kind='spring',
                            seed=0,
                            ax=ax[j])
    j += 1
    
plt.plot()""" ;
