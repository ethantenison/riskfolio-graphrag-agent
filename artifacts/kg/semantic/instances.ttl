<https://riskfolio-graphrag.io/kg/v2/ConstraintsFunctions.py::chunk:42> a rf:Chunk ;
    rf:chunk_index 42 ;
    rf:chunk_kind "function" ;
    rf:content """views0 = views.fillna("")
    views0 = views0[views0["Disabled"] == False]
    data = views0.values.tolist()
    factorslist = loadings.columns.tolist()
    if const == True:
        factorslist = factorslist[1:]
    n = len(views0)
    m = len(factorslist)

    P = []
    Q = []
    for i in range(0, n):
        if data[i][0] == False:
            item = factorslist.index(data[i][1])
            if data[i][2] == ">=":
                d = 1
            elif data[i][2] == "<=":
                d = -1
            P1 = [0] * m
            P1[item] = d
            if data[i][4] != "":
                item = factorslist.index(data[i][4])
                P1[item] = -d
            P.append(P1)
            Q.append([data[i][3] * d])

    P = np.array(P, ndmin=2, dtype=float)
    Q = np.array(Q, ndmin=2, dtype=float)

    return P, Q""" ;
