### 2.1 Calculating the portfolio that maximizes Sharpe ratio.""" ;
    rf:content_hash "c420668ddd7d7d81de3b339ab445bd173ec6b0da625ac505b1cb64dbf059aaad" ;
    rf:line_end 4 ;
