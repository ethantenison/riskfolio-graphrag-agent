<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:111> a rf:Chunk ;
    rf:chunk_index 111 ;
    rf:chunk_kind "function" ;
    rf:content """float
        Risk measure of the portfolio.

    \"\"\"
    w_ = np.array(w, ndmin=2)
    if w_.shape[0] == 1 and w_.shape[1] > 1:
        w_ = w_.T
    if w_.shape[0] > 1 and w_.shape[1] > 1:
        raise ValueError("weights must have n_assets x 1 size")

    if returns.index.tolist() != factors.index.tolist():
        raise ValueError("returns and factors must have same dates.")

    RM = Risk_Margin(
        w=w_,
        returns=returns,
        cov=cov,
        rm=rm,
        rf=rf,
        alpha=alpha,
        a_sim=a_sim,
        beta=beta,
        b_sim=b_sim,
        kappa=kappa,
        solver=solver,
    ).reshape(-1, 1)

    if B is None:
        B = pe.loadings_matrix(
            X=factors,
            Y=returns,
            feature_selection=feature_selection,
            stepwise=stepwise,
            criterion=criterion,
            threshold=threshold,
            n_components=n_components,
        )
        const = True
    elif not isinstance(B, pd.DataFrame):""" ;
    rf:content_hash "c215f6fc72574793db30f3474ee176e7d45abf15b22896a4454c7b339b5429d2" ;
    rf:line_end 2991 ;
    rf:line_start 2966 ;
    rf:relative_path "RiskFunctions.py" ;
    rf:section "Factors_Risk_Contribution" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/RiskFunctions.py" .

<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:112> a rf:Chunk ;
    rf:chunk_index 112 ;
    rf:chunk_kind "function" ;
    rf:content """ponents=n_components,
        )
        const = True
    elif not isinstance(B, pd.DataFrame):
        raise ValueError("B must be a DataFrame")

    if const == True or factors.shape[1] + 1 == B.shape[1]:
        B = B.iloc[:, 1:].to_numpy()

    if feature_selection == "PCR":
        scaler = StandardScaler()
        scaler.fit(factors)
        factors_std = scaler.transform(factors)
        if n_components > 0 and n_components < 1:
            pca = PCA(n_components=n_components)
        elif n_components >= 1:
            pca = PCA(n_components=int(n_components))
        pca.fit(factors_std)
        V_p = pca.components_.T
        std = np.array(np.std(factors, axis=0, ddof=1), ndmin=2)
        B = (pinv(V_p) @ (B.T * std.T)).T

    B1 = pinv(B.T)
    B2 = pinv(null_space(B.T).T)
    B3 = pinv(B2.T)

    RC_F = (B.T @ w_) * (B1.T @ RM)
    RC_OF = np.array(((B2.T @ w_) * (B3.T @ RM)).sum(), ndmin=2)
    RC_F = np.vstack([RC_F, RC_OF]).ravel()

    return RC_F""" ;
    rf:content_hash "c2360dfdcff1e6016cb0246b610485a32c68455a74ea8aa4ea246675978b3fac" ;
    rf:line_end 3012 ;
    rf:line_start 2988 ;
