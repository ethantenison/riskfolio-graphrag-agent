    rf:chunk_index 62 ;
    rf:chunk_kind "function" ;
    rf:content """is None:
        cov = returns.cov()
    elif isinstance(cov, pd.DataFrame):
        if cov.index.tolist() != cov.columns.tolist():
            raise ValueError(
                "cov must be a square DataFrame with samen labels in indexes and columns."
