    rf:content_hash "6bad982a15b0377f2d572256139a8d8aa767f7da04ffe2732e7ac9da958e2acd" ;
    rf:line_end 14 ;
    rf:line_start 14 ;
    rf:relative_path "Tutorial 21 - Constraints on Return and Risk Measures.ipynb" ;
    rf:section "example_section" ;
