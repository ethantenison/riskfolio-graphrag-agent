### 3.1 Calculating the portfolio that maximizes Sharpe ratio.""" ;
    rf:content_hash "8ddac322744bf2b8a0876179e391b6e878766c652e70e29a957ca26c3f08e72a" ;
    rf:line_end 12 ;
    rf:line_start 12 ;
