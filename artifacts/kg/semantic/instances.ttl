<https://riskfolio-graphrag.io/kg/v2/DBHT.py::chunk:41> a rf:Chunk ;
    rf:chunk_index 41 ;
    rf:chunk_kind "function" ;
    rf:content """def LinkageFunction(d, labelvec):
    lvec = np.unique(labelvec)
    Links = np.empty((0, 3))
    for r in range(0, len(lvec) - 1):
        vecr = (labelvec == lvec[r]).reshape(-1)
        for c in range(r + 1, len(lvec)):
            vecc = (labelvec == lvec[c]).reshape(-1)
            x1 = np.ravel(np.logical_or(vecr, vecc))
            dd = d[np.ix_(x1, x1)]

            if dd[dd != 0].shape[0] == 0:
                Link1 = np.hstack((lvec[r], lvec[c], 0))
            else:
                Link1 = np.hstack((lvec[r], lvec[c], np.max(dd[dd != 0], axis=0)))
            Links = np.vstack((Links, Link1))
            del vecc

    dvu = np.min(Links[:, 2], axis=0)
    imn = np.argmin(Links[:, 2], axis=0)
    PairLink = Links[imn, 0:2]

    return (PairLink, dvu)""" ;
    rf:content_hash "76bb51223f59d73fd6ded92428807177b25a3e391e8056435a52edcbdaa5ebab" ;
    rf:line_end 1060 ;
    rf:line_start 1039 ;
    rf:relative_path "DBHT.py" ;
    rf:section "LinkageFunction" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/DBHT.py" .

<https://riskfolio-graphrag.io/kg/v2/DBHT.py::chunk:42> a rf:Chunk ;
    rf:chunk_index 42 ;
    rf:chunk_kind "function" ;
    rf:content """def BubbleMember(Dpm, Rpm, Mv, Mc):
    Mvv = np.zeros((Mv.shape[0], Mv.shape[1]))
    _, vu, _ = sp.find(np.sum(Mc.T, axis=0) > 1)
    _, v, _ = sp.find(np.sum(Mc.T, axis=0) == 1)
    Mvv[v, :] = Mc[v, :]
    for n in range(0, len(vu)):
        _, bub, _ = sp.find(Mc[vu[n], :] != 0)
        vu_bub = np.sum(Rpm[:, vu[n]].reshape(-1, 1) * Mv[:, bub], axis=0).T
        all_bub = np.diag(Mv[:, bub].T @ Rpm @ Mv[:, bub]) / 2
        frac = vu_bub / all_bub
        # mx = np.max(frac, axis=0)
        imx = np.argmax(frac, axis=0)
        Mvv[vu[n], bub[imx]] = 1

    return Mvv""" ;
    rf:content_hash "ebfc6c93809901c4f14e07e43b8069a534ff6fcd67b7eaabfb95450c1b03b37f" ;
    rf:line_end 1077 ;
    rf:line_start 1063 ;
    rf:relative_path "DBHT.py" ;
    rf:section "BubbleMember" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/DBHT.py" .

<https://riskfolio-graphrag.io/kg/v2/DBHT.py::chunk:43> a rf:Chunk ;
    rf:chunk_index 43 ;
    rf:chunk_kind "function" ;
    rf:content """def DendroConstruct(Zi, LabelVec1, LabelVec2, LinkageDist):
    indx = (LabelVec1.T == LabelVec2.T) != 1
    if len(np.unique(LabelVec1[indx])) != 2:
        print("Check the codes")
        return

    Z = np.vstack((Zi, np.hstack((np.sort(np.unique(LabelVec1[indx])), LinkageDist))))

    return Z""" ;
    rf:content_hash "adc053e41596eaebca45370bb4b2b672ab31aad84eaf0dc36c0a7ea3bccfe07c" ;
    rf:line_end 1088 ;
    rf:line_start 1080 ;
    rf:relative_path "DBHT.py" ;
    rf:section "DendroConstruct" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/DBHT.py" .

<https://riskfolio-graphrag.io/kg/v2/DBHT.py::chunk:44> a rf:Chunk ;
    rf:chunk_index 44 ;
    rf:chunk_kind "fallback" ;
    rf:content """\"\"\"\"\"\"  #

\"\"\"
