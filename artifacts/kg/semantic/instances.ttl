<https://riskfolio-graphrag.io/kg/v2/Tutorial%2025%20-%20Hierarchical%20Equal%20Risk%20Contribution%20(HERC)%20Portfolio%20Optimization.ipynb::chunk:10> a rf:Chunk ;
    rf:chunk_index 10 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Plotting the risk contribution per asset

mu = Y.mean()
cov = Y.cov() # Covariance matrix
returns = Y # Returns of the assets

ax = rp.plot_risk_con(w=w,
                      cov=cov,
                      returns=returns,
                      rm=rm,
                      rf=0,
                      alpha=0.05,
                      color="tab:blue",
                      height=6,
                      width=10,
                      t_factor=252,
                      ax=None)""" ;
    rf:content_hash "5d222f3e2d77f05d49d1c8d35a25e03969330bbcfa46e7e6de21dde7bf7c009f" ;
    rf:line_end 10 ;
