<https://riskfolio-graphrag.io/kg/v2/Tutorial%2022%20-%20Logarithmic%20Mean%20Risk%20Optimization%20(Kelly%20Criterion).ipynb::chunk:4> a rf:Chunk ;
    rf:chunk_index 4 ;
    rf:chunk_kind "example_section" ;
    rf:content """## 2. Estimating Logarithmic Mean Variance Portfolios

### 2.1 Calculating the portfolio that maximizes Risk Adjusted Return.""" ;
    rf:content_hash "6a8fd635adb2fa642f1193c50badca1d325da237ba273fc896f17b34a21c2995" ;
    rf:line_end 4 ;
    rf:line_start 4 ;
    rf:relative_path "Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2022%20-%20Logarithmic%20Mean%20Risk%20Optimization%20(Kelly%20Criterion).ipynb::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import riskfolio as rp

# Building the portfolio object
port = rp.Portfolio(returns=Y)

# Calculating optimal portfolio

# Select method and estimate input parameters:

method_mu='hist' # Method to estimate expected returns based on historical data.
method_cov='hist' # Method to estimate covariance matrix based on historical data.

port.assets_stats(method_mu=method_mu, method_cov=method_cov)

# Estimate optimal portfolio:

port.solvers = ['MOSEK']
model='Classic' # Could be Classic (historical), BL (Black Litterman) or FM (Factor Model)
rm = 'MV' # Risk measure used, this time will be variance
obj = 'Sharpe' # Objective function, could be MinRisk, MaxRet, Utility or Sharpe
hist = True # Use historical scenarios for risk measures that depend on scenarios
rf = 0 # Risk free rate
l = 0 # Risk aversion factor, only useful when obj is 'Utility'

w_1 = port.optimization(model=model, rm=rm, obj=obj, kelly=False, rf=rf, l=l, hist=hist)
w_2 = port.optimization(model=model, rm=rm, obj=obj, kell""" ;
    rf:content_hash "5938b3ce8e5c475d066b62415462b618e384a11b801ca5e4031e54ce954de74b" ;
    rf:line_end 5 ;
    rf:line_start 5 ;
    rf:relative_path "Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2022%20-%20Logarithmic%20Mean%20Risk%20Optimization%20(Kelly%20Criterion).ipynb::chunk:6> a rf:Chunk ;
    rf:chunk_index 6 ;
    rf:chunk_kind "example_cell" ;
    rf:content """j=obj, kelly=False, rf=rf, l=l, hist=hist)
w_2 = port.optimization(model=model, rm=rm, obj=obj, kelly='approx', rf=rf, l=l, hist=hist)
w_3 = port.optimization(model=model, rm=rm, obj=obj, kelly='exact', rf=rf, l=l, hist=hist)

w = pd.concat([w_1, w_2, w_3], axis=1)
w.columns = ['Arithmetic', 'Log Approx', 'Log Exact']

display(w)""" ;
    rf:content_hash "213087eb17d9c85f119151781270d726dc257b3d635982ec89630fd8b66bc357" ;
    rf:line_end 5 ;
    rf:line_start 5 ;
    rf:relative_path "Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2022%20-%20Logarithmic%20Mean%20Risk%20Optimization%20(Kelly%20Criterion).ipynb::chunk:7> a rf:Chunk ;
    rf:chunk_index 7 ;
    rf:chunk_kind "example_cell" ;
    rf:content """fig, ax = plt.subplots(figsize=(14,6))
w.plot(kind='bar', ax = ax)""" ;
    rf:content_hash "b6bc90fe3253268795da134fdb022afa1a0969fe454049552b3b3a0db4c5abcb" ;
    rf:line_end 6 ;
    rf:line_start 6 ;
    rf:relative_path "Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2022%20-%20Logarithmic%20Mean%20Risk%20Optimization%20(Kelly%20Criterion).ipynb::chunk:8> a rf:Chunk ;
    rf:chunk_index 8 ;
    rf:chunk_kind "example_cell" ;
    rf:content """returns = port.returns
cov = port.cov

y = 1/(returns.shape[0]) * np.sum(np.log(1 + returns @ w_1.to_numpy()))
x = rp.Sharpe_Risk(w_1, cov=cov, returns=returns, rm=rm, rf=rf, alpha=0.05)
print("Risk Adjusted Return:")
print("Arithmetic", (y/x).item() * 12**0.5)

y = 1/(returns.shape[0]) * np.sum(np.log(1 + returns @ w_2.to_numpy()))
x = rp.Sharpe_Risk(w_2, cov=cov, returns=returns, rm=rm, rf=rf, alpha=0.05)
print("Log Approx", (y/x).item() * 12**0.5)

y = 1/(returns.shape[0]) * np.sum(np.log(1 + returns @ w_3.to_numpy()))
x = rp.Sharpe_Risk(w_3, cov=cov, returns=returns, rm=rm, rf=rf, alpha=0.05)
print("Log Exact", (y/x).item() * 12**0.5)""" ;
    rf:content_hash "caac39a35c190454c91ab1ccbc8ca13827e3af993896f3bd255c432e892833b1" ;
    rf:line_end 7 ;
    rf:line_start 7 ;
    rf:relative_path "Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 22 - Logarithmic Mean Risk Optimization (Kelly Criterion).ipynb" .

