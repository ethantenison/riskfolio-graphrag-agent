    rf:chunk_index 171 ;
    rf:chunk_kind "function" ;
    rf:content """),
                center=center,
                scale=subscale,
                seed=int(seed),
            )
        )

    colors = af.color_list(k)

    label_options = {"ec": "k", "fc": "white", "alpha": 0.7}

    node_options = {
        "node_size": node_size,
        "alpha": node_alpha,
    }
    font_options = {
        "font_size": font_size,
        "font_color": "k",
    }
    # Nodes colored by cluster
    for key, clr in zip(clusters.keys(), colors):
        nx.draw_networkx_nodes(
            G, pos=pos, nodelist=clusters[key], node_color=clr, **node_options
        )
    nx.draw_networkx_edges(G, pos=pos, ax=ax, edge_color="grey")

    if node_labels == True:
        nx.draw_networkx_labels(G, pos=pos, ax=ax, bbox=label_options, **font_options)

    ax.set_yticks([])
    ax.set_yticklabels([])
    for i in {"right", "left", "top", "bottom"}:
        side = ax.spines[i]
        side.set_visible(False)

    if title == "":
        title = (
            "Cluster Network""" ;
