    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 28 - Hierarchical Clustering and Networks.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2028%20-%20Hierarchical%20Clustering%20and%20Networks.ipynb::chunk:12> a rf:Chunk ;
    rf:chunk_index 12 ;
    rf:chunk_kind "example_section" ;
    rf:content "## 6. Clusters Components" ;
