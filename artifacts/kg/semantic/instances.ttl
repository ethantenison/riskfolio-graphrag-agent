<https://riskfolio-graphrag.io/kg/v2/Tutorial%209%20-%20Portfolio%20Optimization%20using%20Risk%20Factors%20and%20Principal%20Components%20Regression%20(PCR).ipynb::chunk:6> a rf:Chunk ;
    rf:chunk_index 6 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 2.2 Calculating the portfolio that maximizes Sharpe ratio." ;
    rf:content_hash "2417e0807a731f30719b7457eeced27f3f29cffee1b1714b185ec438a4e6c667" ;
    rf:line_end 6 ;
    rf:line_start 6 ;
    rf:relative_path "Tutorial 9 - Portfolio Optimization using Risk Factors and Principal Components Regression (PCR).ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 9 - Portfolio Optimization using Risk Factors and Principal Components Regression (PCR).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%209%20-%20Portfolio%20Optimization%20using%20Risk%20Factors%20and%20Principal%20Components%20Regression%20(PCR).ipynb::chunk:7> a rf:Chunk ;
    rf:chunk_index 7 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Building the portfolio object
port = rp.Portfolio(returns=Y)

# Calculating optimal portfolio

# Select method and estimate input parameters:

method_mu='hist' # Method to estimate expected returns based on historical data.
method_cov='hist' # Method to estimate covariance matrix based on historical data.

port.assets_stats(method_mu=method_mu,
                  method_cov=method_cov)

feature_selection = 'PCR' # Method to select best model, could be PCR or Stepwise
n_components = 0.95 # 95% of explained variance. See PCA in scikit learn for more information

port.factors = X
port.factors_stats(method_mu=method_mu,
                   method_cov=method_cov,
                   dict_load=dict(feature_selection=feature_selection,
                                  n_components=n_components)
                  )

# Estimate optimal portfolio:

model='FM' # Factor Model
rm = 'MV' # Risk measure used, this time will be variance
obj = 'Sharpe' # Objective function, could be MinRisk, MaxRet, Ut""" ;
    rf:content_hash "cefb285a1a2cd111433459d83cd1bc4d03568f345b8d76764d1aa0562c99b295" ;
    rf:line_end 7 ;
    rf:line_start 7 ;
    rf:relative_path "Tutorial 9 - Portfolio Optimization using Risk Factors and Principal Components Regression (PCR).ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 9 - Portfolio Optimization using Risk Factors and Principal Components Regression (PCR).ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%209%20-%20Portfolio%20Optimization%20using%20Risk%20Factors%20and%20Principal%20Components%20Regression%20(PCR).ipynb::chunk:8> a rf:Chunk ;
    rf:chunk_index 8 ;
    rf:chunk_kind "example_cell" ;
    rf:content """e used, this time will be variance
obj = 'Sharpe' # Objective function, could be MinRisk, MaxRet, Utility or Sharpe
hist = False # Use historical scenarios for risk measures that depend on scenarios
rf = 0 # Risk free rate
l = 0 # Risk aversion factor, only useful when obj is 'Utility'

w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)

display(w.T)""" ;
    rf:content_hash "dec0878e0051bfa4f4e7c1c19b2823548e76f43f0b04939a1411b551cf744632" ;
    rf:line_end 7 ;
    rf:line_start 7 ;
