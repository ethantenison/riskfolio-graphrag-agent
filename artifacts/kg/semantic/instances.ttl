<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:16> a rf:Chunk ;
    rf:chunk_index 16 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 3.3 Estimating Optimum Portfolio with Key Rate Durations Constraints" ;
    rf:content_hash "66610d878e0ca0b414006cf2162e3114a4b464ce14f5a2801ef4c380e3cf542e" ;
    rf:line_end 14 ;
    rf:line_start 14 ;
    rf:relative_path "Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:17> a rf:Chunk ;
    rf:chunk_index 17 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Estimating optimum portfolio with key rate duration constraints
########################################################################

C, D = rp.factors_constraints(constraints, loadings)

port.ainequality = C
port.binequality = D

w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)

display(w.style.format("{:.4%}").background_gradient(cmap='YlGn'))""" ;
    rf:content_hash "eada39de4d75dd48ef7f0b99af14b3a2eb785b965c7b54df0565098b6bd23689" ;
    rf:line_end 15 ;
    rf:line_start 15 ;
    rf:relative_path "Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" ;
