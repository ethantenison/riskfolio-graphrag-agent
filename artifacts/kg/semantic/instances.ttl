<https://riskfolio-graphrag.io/kg/v2/Tutorial%2024%20-%20Hierarchical%20Risk%20Parity%20(HRP)%20Portfolio%20Optimization.ipynb::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import numpy as np
import pandas as pd
import yfinance as yf
import warnings

warnings.filterwarnings("ignore")
pd.options.display.float_format = '{:.4%}'.format

# Date range
start = '2016-01-01'
end = '2019-12-30'

# Tickers of assets
assets = ['JCI', 'TGT', 'CMCSA', 'CPB', 'MO', 'APA', 'MMC', 'JPM',
          'ZION', 'PSA', 'BAX', 'BMY', 'LUV', 'PCAR', 'TXT', 'TMO',
          'DE', 'MSFT', 'HPQ', 'SEE', 'VZ', 'CNP', 'NI', 'T', 'BA']
assets.sort()

# Downloading data
data = yf.download(assets, start = start, end = end, auto_adjust=False)
data = data.loc[:,('Adj Close', slice(None))]
data.columns = assets""" ;
    rf:content_hash "ec61ae7846b320e7aee76fc1475547c4d0cc755962ff0d30715a5b6e20db392d" ;
    rf:line_end 2 ;
    rf:line_start 2 ;
    rf:relative_path "Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2024%20-%20Hierarchical%20Risk%20Parity%20(HRP)%20Portfolio%20Optimization.ipynb::chunk:3> a rf:Chunk ;
    rf:chunk_index 3 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Calculating returns

Y = data[assets].pct_change().dropna()

display(Y.head())""" ;
    rf:content_hash "a8f8e6e78b9e2b43fbe45e304366ac5eebc6735f53b2d4cf95748ca26503625a" ;
    rf:line_end 3 ;
    rf:line_start 3 ;
    rf:relative_path "Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2024%20-%20Hierarchical%20Risk%20Parity%20(HRP)%20Portfolio%20Optimization.ipynb::chunk:4> a rf:Chunk ;
    rf:chunk_index 4 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import riskfolio as rp

# Plotting Assets Clusters

ax = rp.plot_dendrogram(returns=Y,
                        codependence='pearson',
                        linkage='single',
                        k=None,
                        max_k=10,
                        leaf_order=True,
                        ax=None)""" ;
    rf:content_hash "eccbd0e3ddad64c34a7ec5cf8b370893d753be96e10062ddba510917cd6319eb" ;
    rf:line_end 4 ;
    rf:line_start 4 ;
    rf:relative_path "Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2024%20-%20Hierarchical%20Risk%20Parity%20(HRP)%20Portfolio%20Optimization.ipynb::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
    rf:chunk_kind "example_section" ;
    rf:content """The dendrogram above suggest that optimal number of clusters are four. However HRP portfolios don't use a number of clusters as input.

## 2. Estimating HRP Portfolio

This is the original model proposed by López de Prado (2016). Riskfolio-Lib expand this model to 32 risk measures.

### 2.1 Calculating the HRP portfolio""" ;
    rf:content_hash "1ef1689a5e82cf00d1527cddb648947b7b24659d971ab4b7fb03bdf9c65b62f0" ;
    rf:line_end 5 ;
    rf:line_start 5 ;
    rf:relative_path "Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2024%20-%20Hierarchical%20Risk%20Parity%20(HRP)%20Portfolio%20Optimization.ipynb::chunk:6> a rf:Chunk ;
    rf:chunk_index 6 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Building the portfolio object
port = rp.HCPortfolio(returns=Y)

# Estimate optimal portfolio:

model='HRP' # Could be HRP or HERC
codependence = 'pearson' # Correlation matrix used to group assets in clusters
rm = 'MV' # Risk measure used, this time will be variance
rf = 0 # Risk free rate
linkage = 'single' # Linkage method used to build clusters
max_k = 10 # Max number of clusters used in two difference gap statistic, only for HERC model
leaf_order = True # Consider optimal order of leafs in dendrogram

w = port.optimization(model=model,
                      codependence=codependence,
                      rm=rm,
                      rf=rf,
                      linkage=linkage,
                      max_k=max_k,
                      leaf_order=leaf_order)

display(w.T)""" ;
    rf:content_hash "a8d400e5464e57a75c7982a9a1f5a752644dc2f2745d498bf95efcbc07c0015f" ;
    rf:line_end 6 ;
    rf:line_start 6 ;
    rf:relative_path "Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 24 - Hierarchical Risk Parity (HRP) Portfolio Optimization.ipynb" .

