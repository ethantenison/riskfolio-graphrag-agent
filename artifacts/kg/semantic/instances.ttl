<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
    rf:chunk_kind "function" ;
    rf:content """def CVaR_Hist(X, alpha=0.05):
    r\"\"\"
    Calculate the Conditional Value at Risk (CVaR) of a returns series.

    .. math::
        \\text{CVaR}_{\\alpha}(X) = \\text{VaR}_{\\alpha}(X) +
        \\frac{1}{\\alpha T} \\sum_{t=1}^{T} \\max(-X_{t} -
        \\text{VaR}_{\\alpha}(X), 0)

    Parameters
    ----------
    X : 1d-array
        Returns series, must have Tx1 size.
    alpha : float, optional
        Significance level of CVaR. The default is 0.05.

    Raises
    ------
    ValueError
        When the value cannot be calculated.

    Returns
    -------
    value : float
        CVaR of a returns series.
    \"\"\"

    a = np.array(X, ndmin=2)
    if a.shape[0] == 1 and a.shape[1] > 1:
        a = a.T
    if a.shape[0] > 1 and a.shape[1] > 1:
        raise ValueError("returns must have Tx1 size")

    sorted_a = np.sort(a, axis=0)
    index = int(np.ceil(alpha * len(sorted_a)) - 1)
    sum_var = 0
    for i in range(0, index + 1):
        sum_var = sum_var + sorted_a[i] - sorted_a[index""" ;
    rf:content_hash "5d841cbdfb3313afacb8e0324ebfaf164a008dcefc2ccfcbe7c6a804be11402d" ;
    rf:line_end 302 ;
    rf:line_start 264 ;
    rf:relative_path "RiskFunctions.py" ;
    rf:section "CVaR_Hist" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/RiskFunctions.py" .

<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:50> a rf:Chunk ;
    rf:chunk_index 50 ;
    rf:chunk_kind "function" ;
    rf:content """def TG(X, alpha=0.05, a_sim=100):
    r\"\"\"
    Calculate the Tail Gini of a returns series.

    Parameters
    ----------
    X : 1d-array
        Returns series, must have Tx1 size.
    alpha : float, optional
        Significance level of Tail Gini. The default is 0.05.
    a_sim : float, optional
        Number of CVaRs used to approximate Tail Gini. The default is 100.

    Raises
    ------
    ValueError
        When the value cannot be calculated.

    Returns
    -------
    value : float
        Ulcer Index of a cumpounded cumulative returns.

    \"\"\"

    a = np.array(X, ndmin=2)
    if a.shape[0] == 1 and a.shape[1] > 1:
        a = a.T
    if a.shape[0] > 1 and a.shape[1] > 1:
        raise ValueError("returns must have Tx1 size")

    T = a.shape[0]
    w_ = owa.owa_tg(T, alpha, a_sim)
    value = (w_.T @ np.sort(a, axis=0)).item()

    return value""" ;
    rf:content_hash "997115dbff17dc157b97818037efd79188d9ad06df52884a5b0054603e80862d" ;
    rf:line_end 1524 ;
    rf:line_start 1489 ;
    rf:relative_path "RiskFunctions.py" ;
    rf:section "TG" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/RiskFunctions.py" .

<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:51> a rf:Chunk ;
    rf:chunk_index 51 ;
    rf:chunk_kind "function" ;
    rf:content """def RG(X):
    r\"\"\"
    Calculate the range of a returns series.

    Parameters
    ----------
    X : 1d-array
        Returns series, must have Tx1 size.

    Raises
    ------
    ValueError
        When the value cannot be calculated.

    Returns
    -------
    value : float
        Ulcer Index of a cumpounded cumulative returns.

    \"\"\"

    a = np.array(X, ndmin=2)
    if a.shape[0] == 1 and a.shape[1] > 1:
        a = a.T
    if a.shape[0] > 1 and a.shape[1] > 1:
        raise ValueError("returns must have Tx1 size")

    T = a.shape[0]
    w_ = owa.owa_rg(T)
    value = (w_.T @ np.sort(a, axis=0)).item()

    return value""" ;
    rf:content_hash "997a33ff257cdea7e5209d77215cb92d0a73b4bcb2f3761eab728e3015a1a82f" ;
    rf:line_end 1558 ;
