<https://riskfolio-graphrag.io/kg/v2/Tutorial%2020%20-%20Mean%20Risk%20Optimization%20using%20Black%20Litterman%20and%20Risk%20Factors%20Models.ipynb::chunk:30> a rf:Chunk ;
    rf:chunk_index 30 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Building views on some Risk Factors
########################################################################

views = {'Disabled': [False, False, False, False, False, False],
        'Factor': ['MTUM','USMV','SIZE','R 10800','R 1800','R 3600'],
        'Sign': ['>=', '>=', '>=', '>=', '<=', '<='],
        'Value': [0.02, 0.09, 0.12, 0.001, -0.001, -0.003],
        'Relative Factor': ['VLUE', '', '','R 90', '', '']}
views = pd.DataFrame(views)

display(views)""" ;
