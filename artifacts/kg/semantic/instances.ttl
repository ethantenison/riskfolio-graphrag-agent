    rf:chunk_index 14 ;
    rf:chunk_kind "example_cell" ;
    rf:content """port.acentrality = CV
port.bcentrality = np.ones((1,1))

# Estimate the portfolio that minimizes the risk
w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)

display(w.T)""" ;
