<https://riskfolio-graphrag.io/kg/v2/Tutorial%2018%20-%20Multi%20Assets%20Algorithmic%20Trading%20Backtesting%20with%20Vectorbt.ipynb::chunk:10> a rf:Chunk ;
    rf:chunk_index 10 ;
    rf:chunk_kind "example_cell" ;
    rf:content """%%time

# Risk Measures available:
#
# 'MV': Standard Deviation.
# 'CVaR': Conditional Value at Risk.
# 'EVaR': Entropic Value at Risk.
# 'RLVaR': Relativistic Value at Risk.
# 'WR': Worst Realization (Minimax)
# 'CDaR': Conditional Drawdown at Risk of uncompounded returns.
# 'EDaR': Entropic Drawdown at Risk of uncompounded returns.
# 'RLDaR': Relativistic Drawdown at Risk of uncompounded returns.
# 'MDD': Maximum Drawdown of uncompounded returns (Calmar Ratio).

rms = ["MV", "CVaR", "EVaR", "RLVaR", "WR",
       "CDaR", "EDaR", "RLDaR", "MDD"]

sharpe = {}
portfolio = {}

for i in rms:
    sharpe[i] = np.full(data.shape[0], np.nan)

    # Run simulation with a custom order function (Numba should be disabled)
    portfolio[i] = vbt.Portfolio.from_order_func(
        data,
        order_func_nb,
        pre_sim_func_nb=pre_sim_func_nb,
        pre_sim_args=(30,),
        pre_segment_func_nb=pre_segment_func_nb,
        pre_segment_args=(opt_weights, i, 252*4, ann_factor, num_tests, sha""" ;
    rf:content_hash "8796fd82b1f06827957e1bd15c24a3eb5ab5d85c6c90ef2988d0423009caafe1" ;
    rf:line_end 8 ;
    rf:line_start 8 ;
    rf:relative_path "Tutorial 18 - Multi Assets Algorithmic Trading Backtesting with Vectorbt.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 18 - Multi Assets Algorithmic Trading Backtesting with Vectorbt.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2018%20-%20Multi%20Assets%20Algorithmic%20Trading%20Backtesting%20with%20Vectorbt.ipynb::chunk:11> a rf:Chunk ;
    rf:chunk_index 11 ;
    rf:chunk_kind "example_cell" ;
    rf:content """_nb=pre_segment_func_nb,
        pre_segment_args=(opt_weights, i, 252*4, ann_factor, num_tests, sharpe[i]),
        cash_sharing=True, 
        group_by=True,
        use_numba=False,
    )""" ;
    rf:content_hash "f53f1540df2cd93b9200e79ed5f2914956f42ce35793262fa25f9393992666d1" ;
