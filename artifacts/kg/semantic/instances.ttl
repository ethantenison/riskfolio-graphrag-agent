<https://riskfolio-graphrag.io/kg/v2/reports.rst::chunk:1> a rf:Chunk ;
    rf:chunk_index 1 ;
    rf:chunk_kind "section" ;
    rf:content """onsor&message=%E2%9D%A4&logo=GitHub&color=%23fe8e86
 :target: https://github.com/sponsors/dcajasn

.. raw:: html
   
