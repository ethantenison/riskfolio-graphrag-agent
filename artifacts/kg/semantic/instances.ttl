<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:81> a rf:Chunk ;
    rf:chunk_index 81 ;
    rf:chunk_kind "function" ;
    rf:content """n_assets x 1 size")

    if cov is None:
        cov_ = np.array(np.cov(returns_, rowvar=False), ndmin=2)
    else:
        cov_ = np.array(cov, ndmin=2)

    if mu is None:
        mu_ = np.array(np.mean(returns_, axis=0), ndmin=2)
    else:
        mu_ = np.array(mu, ndmin=2)

    ret = mu_ @ w_
    ret = ret.item()

    risk = Sharpe_Risk(
        returns=returns_,
        w=w_,
        cov=cov_,
        rm=rm,
        rf=rf,
        alpha=alpha,
        a_sim=a_sim,
        beta=beta,
        b_sim=b_sim,
        kappa=kappa,
        kappa_g=kappa_g,
        solver=solver,
    )

    value = (ret - rf) / risk

    return value""" ;
