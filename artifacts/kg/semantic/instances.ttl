    rf:chunk_index 11 ;
    rf:chunk_kind "example_cell" ;
    rf:content """asset_classes = {'Assets': ['MTUM', 'QUAL', 'SIZE', 'USMV', 'VLUE']}

asset_classes = pd.DataFrame(asset_classes)
asset_classes = asset_classes.sort_values(by=['Assets'])

constraints = {'Disabled': [False],
               'Type': ['All Assets'],
               'Set': [''],
               'Position': [''],
               'Sign': ['<='],
               'Weight': [0.30],
               'Type Relative': [''],
               'Relative Set': [''],
               'Relative': [''],
               'Factor': ['']}

constraints = pd.DataFrame(constraints)

display(constraints)""" ;
