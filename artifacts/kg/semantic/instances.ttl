<https://riskfolio-graphrag.io/kg/v2/plot.rst::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "section" ;
    rf:content """message=%E2%9D%A4&logo=GitHub&color=%23fe8e86
 :target: https://github.com/sponsors/dcajasn

.. raw:: html
   
