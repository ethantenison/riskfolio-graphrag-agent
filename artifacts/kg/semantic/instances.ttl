<https://riskfolio-graphrag.io/kg/v2/AuxFunctions.py::chunk:7> a rf:Chunk ;
    rf:chunk_index 7 ;
    rf:chunk_kind "function" ;
    rf:content """Aj = np.empty((0, p * q))
            for i in range(m):
                Aij = (
                    A_[i * p : (i + 1) * p, j * q : (j + 1) * q]
                    .reshape(-1, 1, order="F")
                    .T
                )
                Aj = np.vstack([Aj, Aij])
            bvec_A = np.vstack([bvec_A, Aj])
    else:
        raise ValueError(
            "Dimensions p and q give non integer values for dimensions m and n."
        )

    return bvec_A""" ;
