<https://riskfolio-graphrag.io/kg/v2/Tutorial%2017%20-%20Riskfolio-Lib%20with%20MOSEK%20for%20Real%20Applications%20(612%20assets%20and%204943%20observations).ipynb::chunk:8> a rf:Chunk ;
    rf:chunk_index 8 ;
    rf:chunk_kind "example_cell" ;
    rf:content """eturns.
# 'MDD': Maximum Drawdown of uncompounded cumulative returns (Calmar Ratio).

rms = ["MV", "MAD", "GMD", "MSV", "FLPM", "SLPM",
       "CVaR", "TG", "EVaR", "RLVaR", "WR", "CVRG",
       "TGRG", "RG", "ADD", "UCI", "CDaR", "EDaR",
       "RLDaR", "MDD"]

w = {}
for rm in rms:
    start = timer()
    w[rm] = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)
    end = timer()
    print(rm + ' takes ',timedelta(seconds=end-start))""" ;
