    def frc_optimization(
        self, model="Classic", obj="Sharpe", kelly=None, rf=0, l=2, hist=True
    ):
        r\"\"\"
        This method that calculates the risk parity portfolio using the risk
        budgeting approach :cite:`a-Cajas13` according to the objective function
        selected by the user. The general problem that solves is:

        .. math::
            \\begin{aligned}
            \\underset{w_f}{\\text{optimize}} & \\quad F(w)\\\\
            \\text{s.t.} \\quad & \\quad \\begin{bmatrix} W_{F}  & w_{F} \\\\ w^{\\prime}_{F} & 1 \\end{bmatrix} \\succeq 0 \\\\
            & \\quad A w \\leq b \\\\
            & \\quad w = (B^{\\prime})^{+} w_{F} \\\\
            & \\quad A_{\\text{FR""" ;
    rf:content_hash "79fb7e481f00fdc0afdba89425d8d53dd92c2ec2b27dee9ecaaaa7bd714dd41c" ;
    rf:line_end 4879 ;
    rf:line_start 4851 ;
    rf:relative_path "Portfolio.py" ;
    rf:section "Portfolio" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/Portfolio.py" .

<https://riskfolio-graphrag.io/kg/v2/Portfolio.py::chunk:194> a rf:Chunk ;
    rf:chunk_index 194 ;
    rf:chunk_kind "class" ;
    rf:content """quad A w \\leq b \\\\
            & \\quad w = (B^{\\prime})^{+} w_{F} \\\\
            & \\quad A_{\\text{FRC}} \\text{diag}\\left ( \\bar{\\Sigma} W_{F} \\right) \\leq b_{\\text{FRC}} \\, \\text{Tr} \\left ( \\bar{\\Sigma} W_{F} \\right ) \\\\
            & \\quad W_{F} \\in \\mathbf{S}^{m}\\\\
            \\end{aligned}

        Where:

        :math:`w_f` are the weights of the risk factors.

        :math:`W_f`: is the symmetric matrix variable that approximates :math:`w_f w^{\\prime}_f`.

        :math:`B` is the loadings matrix.

        :math:`Aw \\leq b`: is a set of linear constraints on asset weights.

        :math:`\\bar{\\Sigma} = \\left ((B^{\\prime})^{+} \\right )^{\\prime} \\Sigma (B^{\\prime})^{+}`.

        :math:`A_{\\text{FRC}} \\text{diag}\\left ( \\bar{\\Sigma} W_{F} \\right) \\leq b_{\\text{FRC}} \\, \\text{Tr} \\left ( \\bar{\\Sigma} W_{F} \\right )`: is a set of linear factor risk contribution constraints.

        Parameters
        ----------
        model : str can be 'Classic' or 'FM'
            The model us""" ;
