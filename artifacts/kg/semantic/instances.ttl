    rf:chunk_index 31 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 5.3 Estimating Optimum Portfolio with Key Rate Durations Constraints" ;
    rf:content_hash "4d13c07c7bd39982440ef0bbc36e11d448ebe74fe904bdf13ef924e72baef7aa" ;
    rf:line_end 28 ;
