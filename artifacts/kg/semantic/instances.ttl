<https://riskfolio-graphrag.io/kg/v2/Tutorial%2031%20-%20Hierarchical%20Portfolios%20with%20Custom%20Covariance.ipynb::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
