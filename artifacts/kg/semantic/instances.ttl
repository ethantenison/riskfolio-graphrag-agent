    Y = Y[assets].pct_change().dropna().iloc[-200:]

    port = rp.HCPortfolio(returns=Y)

    model = "HERC"
    codependence = "pearson"
    rf = 0
    linkage = "ward"
    max_k = 10
    leaf_order = True

    rms = [
        "vol",
        "MV",
        "MAD",
        "GMD",
        "MSV",
        "FLPM",
        "SLPM",
        "VaR",
