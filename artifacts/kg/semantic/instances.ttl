<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:7> a rf:Chunk ;
    rf:chunk_index 7 ;
    rf:chunk_kind "function" ;
    rf:content """def WR(X):
    r\"\"\"
    Calculate the Worst Realization (WR) or Worst Scenario of a returns series.

    .. math::
        \\text{WR}(X) = \\max(-X)

    Parameters
    ----------
    X : 1d-array
        Returns series, must have Tx1 size.

    Raises
    ------
    ValueError
        When the value cannot be calculated.

    Returns
    -------
    value : float
        WR of a returns series.

    \"\"\"

    a = np.array(X, ndmin=2)
    if a.shape[0] == 1 and a.shape[1] > 1:
        a = a.T
    if a.shape[0] > 1 and a.shape[1] > 1:
        raise ValueError("returns must have Tx1 size")

    sorted_a = np.sort(a, axis=0)
    value = -sorted_a[0]
    value = np.array(value).item()

    return value""" ;
    rf:content_hash "744ec13964b609a3da5ad0f0070c98f09bbf63a3c36abe15d51f9c7c18d8efd8" ;
    rf:line_end 343 ;
    rf:line_start 309 ;
    rf:relative_path "RiskFunctions.py" ;
    rf:section "WR" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/RiskFunctions.py" .

<https://riskfolio-graphrag.io/kg/v2/RiskFunctions.py::chunk:70> a rf:Chunk ;
    rf:chunk_index 70 ;
    rf:chunk_kind "function" ;
    rf:content """None it
        duplicates a_sim value. The default is None.
    kappa : float, optional
        Deformation parameter of RLVaR and RLDaR for losses, must be between 0 and 1.
        The default is 0.3.
    kappa_g : float, optional
        Deformation parameter of RLVaR and RLDaR for gains, must be between 0 and 1.
        The default is None.
    solver: str, optional
        Solver available for CVXPY that supports exponential and power cone
        programming. Used to calculate RLVaR and RLDaR. The default value is
        'CLARABEL'.

    Raises
    ------
    ValueError
        When the value cannot be calculated.

    Returns
    -------
    value : float
        Risk measure of the portfolio.

    \"\"\"

    if isinstance(returns, pd.Series):
        returns_ = returns.to_frame()
    elif isinstance(returns, pd.DataFrame):
        returns_ = returns.to_numpy()
    else:
        returns_ = np.array(returns, ndmin=2)

    if returns_.shape[1] == 1:
        w_ = np.array([[1]])""" ;
    rf:content_hash "f857c4f8aac545be5b9736e540e0d50b78444b5182b58bc7273b925d954cb139" ;
    rf:line_end 2059 ;
