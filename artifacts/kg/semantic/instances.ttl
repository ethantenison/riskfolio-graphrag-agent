<https://riskfolio-graphrag.io/kg/v2/Tutorial%2024%20-%20Hierarchical%20Risk%20Parity%20(HRP)%20Portfolio%20Optimization.ipynb::chunk:11> a rf:Chunk ;
    rf:chunk_index 11 ;
