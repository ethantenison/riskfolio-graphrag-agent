<https://riskfolio-graphrag.io/kg/v2/Portfolio.py::chunk:466> a rf:Chunk ;
    rf:chunk_index 466 ;
    rf:chunk_kind "function" ;
    rf:content """(self.factors)
            if self.n_components > 0 and self.n_components < 1:
                pca = PCA(n_components=self.n_components)
            elif self.n_components >= 1:
                pca = PCA(n_components=int(self.n_components))
            pca.fit(X_std)
            V_p = pca.components_.T
            std = np.array(np.std(self.factors, axis=0, ddof=1), ndmin=2)
            B1 = (pinv(V_p) @ (B1.T * std.T)).T

        B2 = pinv(B1.T)
        N_f = B2.shape[1]
        w1 = cp.Variable((N_f, 1))
        w = B2 @ w1

        k = cp.Variable((1, 1))
        gr = cp.Variable((T, 1))
        g = cp.Variable(nonneg=True)
        rf0 = rf

        constraints = []

        # Variance Variables

        W1 = cp.Variable((N_f, N_f), symmetric=True)
        M1 = cp.vstack([W1, w1.T])
        if obj == "Sharpe":
            M2 = cp.vstack([w1, k])
        else:
            M2 = cp.vstack([w1, np.ones((1, 1))])
        M3 = cp.hstack([M1, M2])

        risk = cp.trace(B2.T @ sigma @ B2""" ;
