        "EDaR_Rel",
        "UCI_Rel",
    ]

    w_1 = pd.DataFrame([])

    for i in rms:
        w = port.optimization(
            model=model,
            codependence=codependence,
            rm=i,
            rf=rf,
            linkage=linkage,
            max_k=max_k,
            leaf_order=leaf_order,""" ;
