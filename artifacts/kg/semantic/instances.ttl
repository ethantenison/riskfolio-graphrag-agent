<https://riskfolio-graphrag.io/kg/v2/Tutorial%2046%20-%20Classic%20Mean%20Risk%20Optimization%20with%20Network%20and%20Dendrogram%20Constraints.ipynb::chunk:11> a rf:Chunk ;
    rf:chunk_index 11 ;
    rf:chunk_kind "example_section" ;
    rf:content """## 3. Estimating Mean Risk Portfolios with Constraints in Centrality Measure Vector and Connection Matrix 

### 3.1 Calculating the Centrality Measure Vector and Connection Matrix""" ;
    rf:content_hash "354090dfcc76d9b21b5607f204b2378b5c36021c0e1d9dc9c7d032aafe584c7f" ;
    rf:line_end 10 ;
    rf:line_start 10 ;
    rf:relative_path "Tutorial 46 - Classic Mean Risk Optimization with Network and Dendrogram Constraints.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 46 - Classic Mean Risk Optimization with Network and Dendrogram Constraints.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2046%20-%20Classic%20Mean%20Risk%20Optimization%20with%20Network%20and%20Dendrogram%20Constraints.ipynb::chunk:12> a rf:Chunk ;
    rf:chunk_index 12 ;
    rf:chunk_kind "example_cell" ;
    rf:content """CV = rp.centrality_vector(Y,
                          measure='Degree',
                          codependence="pearson",
                          graph="MST")

B_1 = rp.connection_matrix(Y,
                           codependence="pearson",
                           graph="MST",
                           walk_size=1)

print("Centrality Measure Vector")
print(CV)
print("Connection Matrix")
print(B_1)""" ;
    rf:content_hash "095e7bf06d8b811708571561c1e09bf750f6b112313e22180380630d2739b914" ;
    rf:line_end 11 ;
