<https://riskfolio-graphrag.io/kg/v2/Tutorial%2052%20-%20Portfolio%20Optimization%20with%20Integer%20Constraints.ipynb::chunk:7> a rf:Chunk ;
    rf:chunk_index 7 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import riskfolio as rp

# Building the portfolio object
port = rp.Portfolio(returns=Y)

# Calculating optimum portfolio

# Select method and estimate input parameters:

method_mu='hist' # Method to estimate expected returns based on historical data.
method_cov='hist' # Method to estimate covariance matrix based on historical data.

port.assets_stats(method_mu=method_mu, method_cov=method_cov)

# Estimate optimal portfolio:

model='Classic' # Could be Classic (historical), BL (Black Litterman) or FM (Factor Model)
rm = 'MV' # Risk measure used, this time will be variance
obj = 'MinRisk' # Objective function, could be MinRisk, MaxRet, Utility or Sharpe
hist = True # Use historical scenarios for risk measures that depend on scenarios
rf = 0 # Risk free rate
l = 0 # Risk aversion factor, only useful when obj is 'Utility'

w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)

display(w.T)""" ;
    rf:content_hash "8b5217f3ec0ca3e03fbe9613e412ce9f644db69acc5591eae9936421d4a8c955" ;
    rf:line_end 6 ;
    rf:line_start 6 ;
    rf:relative_path "Tutorial 52 - Portfolio Optimization with Integer Constraints.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 52 - Portfolio Optimization with Integer Constraints.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2052%20-%20Portfolio%20Optimization%20with%20Integer%20Constraints.ipynb::chunk:8> a rf:Chunk ;
    rf:chunk_index 8 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Plotting the composition of the portfolio

ax = rp.plot_pie(w=w,
                 title='Minimum Variance',
                 others=0.05,
                 nrow=25,
                 cmap="tab20",
                 height=6,
                 width=10,
                 ax=None)""" ;
    rf:content_hash "0c2247f594f5a76488018bfaa28f16daa1fe3780392fee5fcc2ec5e57802f8d9" ;
    rf:line_end 7 ;
    rf:line_start 7 ;
    rf:relative_path "Tutorial 52 - Portfolio Optimization with Integer Constraints.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 52 - Portfolio Optimization with Integer Constraints.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2052%20-%20Portfolio%20Optimization%20with%20Integer%20Constraints.ipynb::chunk:9> a rf:Chunk ;
    rf:chunk_index 9 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Number of assets in portfolio
n_assets = np.sum(np.where(np.round(w, 4) > 0, 1, 0)).item()

# Number of industries in portfolio
D0 = []
classes = asset_classes['Industry'].unique().tolist()
for i in classes:
    D1 = np.where(asset_classes['Industry'].values == i, 1, 0).tolist()
    D0.append(D1)
D0 = np.array(D0)
D0 = pd.DataFrame(D0, index=classes, columns=assets)
n_industries = np.sum(np.where(np.round(D0 @ w, 4) > 0, 1, 0)).item()

print('Number of Assets    :', n_assets, 'from', w.shape[0])
print('Number of Industries:', n_industries, 'from', D0.shape[0])""" ;
    rf:content_hash "d09bd02e603aab2a551c977b5edf29b8590ea91cb18c544408836db273aedd85" ;
    rf:line_end 8 ;
