<https://riskfolio-graphrag.io/kg/v2/Portfolio.py::chunk:262> a rf:Chunk ;
    rf:chunk_index 262 ;
    rf:chunk_kind "function" ;
    rf:content """def benchweights(self):
        n = self.numassets
        if self._benchweights is not None:
            if self._benchweights.shape[0] == n and self._benchweights.shape[1] == 1:
                a = self._benchweights
            else:
                raise NameError("Weights must have a size of shape (n_assets, 1).")
        else:
            a = np.array(np.ones((n, 1)) / n)
        return a""" ;
    rf:content_hash "d3e5a0ed3388a87adcd0a70e70eb5e2cd0ba9ff8e2f4fbb6766cfb543c357985" ;
