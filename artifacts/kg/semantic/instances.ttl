    rf:section "assets_constraints" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/ConstraintsFunctions.py" .

<https://riskfolio-graphrag.io/kg/v2/ConstraintsFunctions.py::chunk:10> a rf:Chunk ;
    rf:chunk_index 10 ;
    rf:chunk_kind "function" ;
    rf:content """f data[i][4] == ">=":
                d = 1
            elif data[i][4] == "<=":
                d = -1
            if data[i][5] != "":
                for k in np.unique(asset_classes[data[i][2]].values):
                    A1 = np.where(asset_classes[data[i][2]].values == k, 1, 0) * d
                    A1 = A1.tolist()
                    A.append(A1)
                    B.append([data[i][5] * d])
            else:
                for k in np.unique(asset_classes[data[i][2]].values):
