<https://riskfolio-graphrag.io/kg/v2/Tutorial%2051%20-%20Classic%20Mean%20Variance%20Optimization%20with%20Risk%20Factor%20Contribution%20Inequalities%20Constraints.ipynb::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import numpy as np
import pandas as pd
import yfinance as yf
import warnings

warnings.filterwarnings("ignore")
pd.options.display.float_format = '{:.4%}'.format

# Date range
start = '2016-01-01'
end = '2019-12-30'

# Tickers of assets
assets = ['JCI', 'TGT', 'CMCSA', 'CPB', 'MO', 'APA', 'MMC', 'JPM',
          'ZION', 'PSA', 'BAX', 'BMY', 'LUV', 'PCAR', 'TXT', 'TMO',
          'DE', 'MSFT', 'HPQ', 'SEE', 'VZ', 'CNP', 'NI', 'T', 'BA']
assets.sort()

# Tickers of factors
factors = ['MTUM', 'QUAL', 'SIZE', 'USMV', 'VLUE']
factors.sort()

# All Tickers
tickers = assets + factors
tickers.sort()

# Downloading data
prices = yf.download(tickers, start = start, end = end, auto_adjust=False)
prices = prices.loc[:,('Adj Close', slice(None))]
prices.columns = tickers

# Calculating returns of Assets and Factors
returns = prices[tickers].pct_change().dropna()

# Separate Exogenous and Endogenous Variables
F = returns[factors]
Y = returns[assets]""" ;
    rf:content_hash "a1b565ecb72e942202ef1ab9623a8dbca7f5a0b97fc6f0727d9c8e096958bc52" ;
    rf:line_end 2 ;
