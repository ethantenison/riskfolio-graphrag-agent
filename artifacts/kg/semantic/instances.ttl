import numpy as np
import cvxpy as cp
import math
from scipy.special import binom

__all__ = [
    "owa_l_moment",
    "owa_gmd",
    "owa_cvar",
    "owa_wcvar",
    "owa_tg",
    "owa_wr",
    "owa_rg",
    "owa_cvrg",
    "owa_wcvrg",
    "owa_tgrg",
    "owa_l_moment_crm",
]""" ;
    rf:content_hash "5cefabe694c56bb4f1786758e13f4973034dd9d30c38c6e663cfef3903c725c0" ;
    rf:line_end 29 ;
    rf:line_start 1 ;
    rf:relative_path "OwaWeights.py" ;
    rf:section "fallback" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/OwaWeights.py" .

<https://riskfolio-graphrag.io/kg/v2/OwaWeights.py::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "function" ;
    rf:content """def owa_cvar(T, alpha=0.05):
    r\"\"\"
    Calculate the OWA weights to calculate the Conditional Value at Risk (CVaR)
    of a returns series as shown in :cite:`d-Cajas3`.

    Parameters
    ----------
    T : int
        Number of observations of the returns series.
    alpha : float, optional
        Significance level of CVaR. The default is 0.05.

    Returns
    -------
    value : 1d-array
        An OWA weights vector of size Tx1.
    \"\"\"

    T_ = int(T)
    k = int(np.ceil(T_ * alpha)) - 1
    w_ = np.zeros((T_, 1))
    w_[:k, :] = -1 / (T_ * alpha)
    w_[k, :] = -1 - np.sum(w_[:k, :])

    return w_""" ;
    rf:content_hash "88ba07d4593316c921d2ce89718cb031c1179f66117a23ed0d5b313138b32904" ;
    rf:line_end 110 ;
    rf:line_start 86 ;
    rf:relative_path "OwaWeights.py" ;
    rf:section "owa_cvar" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/OwaWeights.py" .

<https://riskfolio-graphrag.io/kg/v2/OwaWeights.py::chunk:3> a rf:Chunk ;
    rf:chunk_index 3 ;
    rf:chunk_kind "function" ;
    rf:content """def owa_wcvar(T, alphas, weights):
    r\"\"\"
    Calculate the OWA weights to calculate the Weighted Conditional Value at
    Risk (WCVaR) of a returns series as shown in :cite:`d-Cajas3`.

    Parameters
    ----------
    T : int
        Number of observations of the returns series.
    alphas : list
        List of significance levels of each CVaR model.
    weights : list
        List of weights of each CVaR model.

    Returns
    -------
    value : 1d-array
        An OWA weights vector of size Tx1.
    \"\"\"

    w_ = 0
    T_ = int(T)
    for i, j in zip(alphas, weights):
        w_ += owa_cvar(T_, i) * j

    return w_""" ;
    rf:content_hash "47787b9e6ff33e25a42fce90e06d4060cf3c5333a3395c26ea5a2ae4f8369cec" ;
    rf:line_end 138 ;
    rf:line_start 113 ;
    rf:relative_path "OwaWeights.py" ;
    rf:section "owa_wcvar" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/OwaWeights.py" .

<https://riskfolio-graphrag.io/kg/v2/OwaWeights.py::chunk:4> a rf:Chunk ;
    rf:chunk_index 4 ;
    rf:chunk_kind "function" ;
    rf:content """def owa_tg(T, alpha=0.05, a_sim=100):
    r\"\"\"
    Calculate the OWA weights to calculate the Tail Gini of a
    returns series as shown in :cite:`d-Cajas3`.

    Parameters
    ----------
    T : int
        Number of observations of the returns series.
    alpha : float, optional
        Significance level of TaiL Gini. The default is 0.05.
    a_sim : float, optional
        Number of CVaRs used to approximate the Tail Gini. The default is 100.

    Returns
    -------
    value : 1d-array
        A OWA weights vector of size Tx1.
    \"\"\"
    T_ = int(T)
    a_sim_ = int(a_sim)
    alphas = np.linspace(alpha, 0.0001, a_sim_)[::-1]
    w_ = [(alphas[1] - 0) * alphas[0] / alphas[-1] ** 2]
    for i in range(1, len(alphas) - 1):
        w_.append((alphas[i + 1] - alphas[i - 1]) * alphas[i] / alphas[-1] ** 2)
    w_.append((alphas[-1] - alphas[-2]) / alphas[-1])
    w_ = owa_wcvar(T_, alphas, w_)

    return w_""" ;
    rf:content_hash "d26cc83f734cd3cd7f8ab4f8e4d56a61f237eee17b074b9cc5b86db0efe5ab2f" ;
    rf:line_end 169 ;
    rf:line_start 141 ;
    rf:relative_path "OwaWeights.py" ;
    rf:section "owa_tg" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/OwaWeights.py" .

<https://riskfolio-graphrag.io/kg/v2/OwaWeights.py::chunk:5> a rf:Chunk ;
    rf:chunk_index 5 ;
    rf:chunk_kind "function" ;
    rf:content """def owa_wr(T):
    r\"\"\"
    Calculate the OWA weights to calculate the Worst realization (minimum)
    of a returns series as shown in :cite:`d-Cajas3`.

    Parameters
    ----------
    T : int
        Number of observations of the returns series.

    Returns
    -------
    value : 1d-array
        A OWA weights vector of size Tx1.
    \"\"\"

    T_ = int(T)
    w_ = np.zeros((T_, 1))
    w_[0, :] = -1

    return w_""" ;
    rf:content_hash "8c3cdcc3689a5aec4c8b2ac4bb13bda76a6136a1ba59697d91e514e1e15ef203" ;
    rf:line_end 192 ;
    rf:line_start 172 ;
    rf:relative_path "OwaWeights.py" ;
    rf:section "owa_wr" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/OwaWeights.py" .

<https://riskfolio-graphrag.io/kg/v2/OwaWeights.py::chunk:6> a rf:Chunk ;
    rf:chunk_index 6 ;
    rf:chunk_kind "function" ;
    rf:content """def owa_rg(T):
    r\"\"\"
    Calculate the OWA weights to calculate the range of a returns series
    as shown in :cite:`d-Cajas3`.

    Parameters
    ----------
    T : int
        Number of observations of the returns series.

    Returns
    -------
    value : 1d-array
        A OWA weights vector of size Tx1.
    \"\"\"

    T_ = int(T)
    w_ = np.zeros((T_, 1))
    w_[0, :] = -1
    w_[-1, :] = 1

    return w_""" ;
    rf:content_hash "fb0672ecfc6f4824470d53462c517cad7051f01af99a14782378668fc4fed8b6" ;
    rf:line_end 216 ;
    rf:line_start 195 ;
    rf:relative_path "OwaWeights.py" ;
    rf:section "owa_rg" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/OwaWeights.py" .

<https://riskfolio-graphrag.io/kg/v2/OwaWeights.py::chunk:7> a rf:Chunk ;
    rf:chunk_index 7 ;
    rf:chunk_kind "function" ;
    rf:content """def owa_cvrg(T, alpha=0.05, beta=None):
    r\"\"\"
    Calculate the OWA weights to calculate the CVaR range of a returns series
    as shown in :cite:`d-Cajas3`.

    Parameters
    ----------
    T : int
        Number of observations of the returns series.
    alpha : float, optional
        Significance level of CVaR of losses. The default is 0.05.
    beta : float, optional
        Significance level of CVaR of gains. If None it duplicates alpha.
        The default is None.

    Returns
    -------
    value : 1d-array
        A OWA weights vector of size Tx1.
    \"\"\"

    T_ = int(T)
    if beta is None:
        beta = alpha

    w_ = owa_cvar(T_, alpha) - owa_cvar(T_, beta)[::-1]

    return w_""" ;
    rf:content_hash "5039cf22055ce41dd8e95688a4258edc0af287d0d0c0f35095bfcd2db1d3f628" ;
    rf:line_end 246 ;
    rf:line_start 219 ;
    rf:relative_path "OwaWeights.py" ;
    rf:section "owa_cvrg" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/OwaWeights.py" .

<https://riskfolio-graphrag.io/kg/v2/OwaWeights.py::chunk:8> a rf:Chunk ;
    rf:chunk_index 8 ;
    rf:chunk_kind "function" ;
    rf:content """def owa_wcvrg(T, alphas, weights_a, betas=None, weights_b=None):
    r\"\"\"
    Calculate the OWA weights to calculate the WCVaR range of a returns series
    as shown in :cite:`d-Cajas3`.

    Parameters
    ----------
    T : int
        Number of observations of the returns series.
    alphas : list
        List of significance levels of each CVaR of losses model.
    weights_a : list
        List of weights of each CVaR of losses model.
    betas : list, optional
        List of significance levels of each CVaR of gains model. If None it duplicates alpha.
        The default is None.
    weights_b : list, optional
        List of weights of each CVaR of gains model. If None it duplicates weights_a.
        The default is None.

    Returns
    -------
    value : 1d-array
        A OWA weights vector of size Tx1.
    \"\"\"

    T_ = int(T)
    if betas is None or weights_b is None:
        betas = alphas
        weights_b = weights_a

    w_ = owa_wcvar(T_, alphas, weights_a) - owa_wcv""" ;
    rf:content_hash "95fd070b1acad1f375c1487805cf85f5babf6a7664f8b120bf8ad0a83d362fc6" ;
    rf:line_end 281 ;
    rf:line_start 249 ;
    rf:relative_path "OwaWeights.py" ;
    rf:section "owa_wcvrg" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/OwaWeights.py" .

<https://riskfolio-graphrag.io/kg/v2/OwaWeights.py::chunk:9> a rf:Chunk ;
    rf:chunk_index 9 ;
    rf:chunk_kind "function" ;
    rf:content """betas = alphas
        weights_b = weights_a

    w_ = owa_wcvar(T_, alphas, weights_a) - owa_wcvar(T_, betas, weights_b)[::-1]

    return w_""" ;
    rf:content_hash "63503b1ffe73fad9ecde9b3e5efdd42534e9a30347cacef289e9f6f87f400eaa" ;
    rf:line_end 282 ;
    rf:line_start 278 ;
    rf:relative_path "OwaWeights.py" ;
    rf:section "owa_wcvrg" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/OwaWeights.py" .

<https://riskfolio-graphrag.io/kg/v2/ParamsEstimation.py::chunk:0> a rf:Chunk ;
    rf:chunk_index 0 ;
    rf:chunk_kind "function" ;
    rf:content """def mean_vector(X, method="hist", d=0.94, target="b1"):
    r\"\"\"
    Calculate the expected returns vector using the selected method.

    Parameters
    ----------
    X : DataFrame of shape (n_samples, n_assets)
        Assets returns DataFrame, where n_samples is the number of
        observations and n_assets is the number of assets.
    method : str, optional
        The method used to estimate the expected returns.
        The default value is 'hist'. Possible values are:

        - 'hist': use historical estimator.
        - 'ewma1': use ewma with adjust=True. For more information see `EWM <https://pandas.pydata.org/pandas-docs/stable/user_guide/window.html#exponentially-weighted-window>`__.
        - 'ewma2': use ewma with adjust=False. For more information see `EWM <https://pandas.pydata.org/pandas-docs/stable/user_guide/window.html#exponentially-weighted-window>`__.
        - 'JS': James-Stein estimator. For more information see :cite:`b-Meucci2005` and :cite:`b-Feng2016`.""" ;
    rf:content_hash "bf1aef8c0db2158edbaf2fe9a4e831b8855cc942bc0f24606311cb3ed7c51219" ;
    rf:line_end 70 ;
    rf:line_start 44 ;
    rf:relative_path "ParamsEstimation.py" ;
    rf:section "mean_vector" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/ParamsEstimation.py" .

<https://riskfolio-graphrag.io/kg/v2/ParamsEstimation.py::chunk:1> a rf:Chunk ;
    rf:chunk_index 1 ;
    rf:chunk_kind "function" ;
    rf:content """JS': James-Stein estimator. For more information see :cite:`b-Meucci2005` and :cite:`b-Feng2016`.
        - 'BS': Bayes-Stein estimator. For more information see :cite:`b-Jorion1986`.
        - 'BOP': BOP estimator. For more information see :cite:`b-Bodnar2019`.

    d : scalar
        The smoothing factor of ewma methods.
        The default is 0.94.

    target : str, optional
        The target mean vector. The default value is 'b1'.
        Possible values are:

        - 'b1': grand mean.
        - 'b2': volatility weighted grand mean.
        - 'b3': mean square error of sample mean.

    Returns
    -------
    mu : 1d-array
        The estimation of expected returns.

    Raises
    ------
    ValueError
        When the value cannot be calculated.

    \"\"\"

    if not isinstance(X, pd.DataFrame):
        raise ValueError("X must be a DataFrame")

    assets = X.columns.tolist()

    if method == "hist":
        mu = np.array(X.mean(), ndmin=2)
    elif method == "ewma1":""" ;
    rf:content_hash "70af7ed02fed9081e36f72c0d8bd7a49dcf552976b9db5963221dbd5f418d895" ;
    rf:line_end 94 ;
    rf:line_start 67 ;
    rf:relative_path "ParamsEstimation.py" ;
    rf:section "mean_vector" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/ParamsEstimation.py" .

<https://riskfolio-graphrag.io/kg/v2/ParamsEstimation.py::chunk:10> a rf:Chunk ;
    rf:chunk_index 10 ;
    rf:chunk_kind "function" ;
    rf:content """detone=detone,
            mkt_comp=int(mkt_comp),
            alpha=alpha,
        )
    elif method == "gerber1":
        cov = gs.gerber_cov_stat1(X, threshold=threshold)
    elif method == "gerber2":
        cov = gs.gerber_cov_stat2(X, threshold=threshold)

    cov = pd.DataFrame(np.array(cov, ndmin=2), columns=assets, index=assets)

    return cov""" ;
