    rf:chunk_index 15 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 3.2 Calculating the NCO portfolio with constraints" ;
    rf:content_hash "88fd637d50796078c629e18227e040b92d55c34761221f0ffb45c32391f85565" ;
    rf:line_end 13 ;
    rf:line_start 13 ;
    rf:relative_path "Tutorial 45 - Nested Clustered Optimization (NCO) Portfolio Optimization with Constraints.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 45 - Nested Clustered Optimization (NCO) Portfolio Optimization with Constraints.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2045%20-%20Nested%20Clustered%20Optimization%20(NCO)%20Portfolio%20Optimization%20with%20Constraints.ipynb::chunk:16> a rf:Chunk ;
    rf:chunk_index 16 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Estimate optimal portfolio with constraints:

w_max, w_min = rp.hrp_constraints(constraints, asset_classes)

port.w_max = w_max
port.w_min = w_min

w_1 = port.optimization(model=model,
                        codependence=codependence,
                        method_cov=method_cov,
                        obj=obj,
                        rm=rm,
                        rf=rf,
                        l=l,
                        linkage=linkage,
                        max_k=max_k,
                        leaf_order=leaf_order)

display(w_1.T)""" ;
