<https://riskfolio-graphrag.io/kg/v2/GerberStatistic.py::chunk:6> a rf:Chunk ;
    rf:chunk_index 6 ;
    rf:chunk_kind "function" ;
    rf:content """def gerber_cov_stat2(X, threshold=0.5):
    r\"\"\"
    Compute Gerber covariance Statistics 2 :cite:`d-Gerber2021`.

    Parameters
    ----------
    X : : DataFrame of shape (n_samples, n_assets), optional
        Assets returns DataFrame, where n_samples is the number of
        observations and n_assets is the number of assets.

    threshold : float
        Threshold is between 0 and 1.

    Returns
    -------
    value : bool
        Gerber covariance mtrix of shape (n_features, n_features), where
        n_features is the number of features.

    Raises
    ------
        ValueError when the value cannot be calculated.

    \"\"\"
    # Threshold shall between 0 and 1
    assert 1 > threshold > 0

    flag = False
    if isinstance(X, pd.DataFrame):
        cols = X.columns.tolist()
        X1 = X.to_numpy()
        flag = True
    else:
        X1 = X.copy()

    n, p = X1.shape
    sd_vec = X1.std(axis=0).reshape((p, 1))
    U = np.copy(X1)
    D = np.copy(X1)

    # Update U and""" ;
    rf:content_hash "a74d3530ad901b393ed946973165b6ee473b3d3a00e61d4c39f19a7d82b08ea4" ;
    rf:line_end 218 ;
    rf:line_start 178 ;
    rf:relative_path "GerberStatistic.py" ;
    rf:section "gerber_cov_stat2" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/riskfolio/src/GerberStatistic.py" .

<https://riskfolio-graphrag.io/kg/v2/GerberStatistic.py::chunk:7> a rf:Chunk ;
    rf:chunk_index 7 ;
    rf:chunk_kind "function" ;
    rf:content """sd_vec = X1.std(axis=0).reshape((p, 1))
    U = np.copy(X1)
    D = np.copy(X1)

    # Update U and D matrix
    for i in range(p):
        U[:, i] = U[:, i] >= sd_vec[i] * threshold
        D[:, i] = D[:, i] <= -sd_vec[i] * threshold

    # Update concordant matrix
    N_CONC = U.transpose() @ U + D.transpose() @ D

    # Update discordant matrix
    N_DISC = U.transpose() @ D + D.transpose() @ U
    H = N_CONC - N_DISC
    h = np.sqrt(H.diagonal())
    h = h.reshape((p, 1))

    corr = H / (h @ h.transpose())

    cov = corr * np.outer(sd_vec, sd_vec)

    if flag:
        cov = pd.DataFrame(cov, index=cols, columns=cols)

    return cov""" ;
    rf:content_hash "cbb792fb1b5aea8b5fffb93ad960e23e03c840a5635630cf2537bce69a3fae82" ;
    rf:line_end 239 ;
    rf:line_start 214 ;
