    rf:chunk_index 22 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import statsmodels.api as sm

X1 = sm.add_constant(X)
y = np.matrix(returns) * np.matrix(w)
results = sm.OLS(y, X1).fit()
coefs = results.params

print(coefs)""" ;
