    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:20> a rf:Chunk ;
    rf:chunk_index 20 ;
    rf:chunk_kind "example_section" ;
    rf:content """## 4. Estimating Mean Variance Portfolio

### 4.1 Building the loadings matrix and risk factors returns.

This part shows how to build a personalized loadings matrix that will be used by __Riskfolio-Lib__ to calculate the expected returns and covariance matrix.""" ;
    rf:content_hash "6f9a2aea46f6a98b3bfbb387d5dc60bb1826b14b0372036aece7d51d63a44bc2" ;
    rf:line_end 18 ;
    rf:line_start 18 ;
    rf:relative_path "Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:21> a rf:Chunk ;
    rf:chunk_index 21 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Building the risk factors returns matrix
########################################################################

# Removing bond returns from factors matrix
cols = assets_returns.columns
cols = ~cols.isin(loadings.index)
cols = assets_returns.columns[cols]

# Other approach for removing bond returns from factors matrix
cols = [col for col in assets_returns.columns if col not in loadings.index]

X = pd.concat([assets_returns[cols], X], axis=1)

display(X.head())""" ;
    rf:content_hash "310f46d6da3422dfd6edaf20146fe71d94bd024b4335abd75a7764f2f725a971" ;
    rf:line_end 19 ;
