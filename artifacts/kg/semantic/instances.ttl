<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:24> a rf:Chunk ;
    rf:chunk_index 24 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 4.2 Calculating the portfolio that maximizes Sharpe ratio." ;
    rf:content_hash "6ee91d12857f71e6ec41809928c179db89fbda57a0213cb4e00836880521033d" ;
    rf:line_end 22 ;
    rf:line_start 22 ;
    rf:relative_path "Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:25> a rf:Chunk ;
    rf:chunk_index 25 ;
    rf:chunk_kind "example_cell" ;
    rf:content """########################################################################
# Calculating optimum portfolio
########################################################################

port = rp.Portfolio(returns=Y)

# Select method and estimate input parameters:

method_mu='hist' # Method to estimate expected returns based on historical data.
method_cov='hist' # Method to estimate covariance matrix based on historical data.

port.assets_stats(method_mu=method_mu, method_cov=method_cov)

port.factors = X
port.factors_stats(method_mu=method_mu, method_cov=method_cov, B=loadings, const=False)

# Estimate optimal portfolio:

model='FM' # Factor Model
rm = 'MV' # Risk measure used, this time will be variance
obj = 'Sharpe' # Objective function, could be MinRisk, MaxRet, Utility or Sharpe
hist = False # Use historical scenarios for risk measures that depend on scenarios
rf = 0 # Risk free rate
l = 0 # Risk aversion factor, only useful when obj is 'Utility'

w = port.optimization(model=model, rm=r""" ;
    rf:content_hash "dce6d3ab58d773cc6a0ebca4858ce42a37ddef70268ab354b7c542796319af68" ;
    rf:line_end 23 ;
    rf:line_start 23 ;
    rf:relative_path "Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 4 - Bond Portfolio Optimization and Immunization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%204%20-%20Bond%20Portfolio%20Optimization%20and%20Immunization.ipynb::chunk:26> a rf:Chunk ;
    rf:chunk_index 26 ;
    rf:chunk_kind "example_cell" ;
    rf:content """0 # Risk aversion factor, only useful when obj is 'Utility'

w = port.optimization(model=model, rm=rm, obj=obj, rf=rf, l=l, hist=hist)

display(w.style.format("{:.4%}").background_gradient(cmap='YlGn'))""" ;
    rf:content_hash "f005f559dbb4ab915649709efcbf2efc0f24a83cb1bf9025ecbfe8d22e3375d2" ;
    rf:line_end 23 ;
    rf:line_start 23 ;
