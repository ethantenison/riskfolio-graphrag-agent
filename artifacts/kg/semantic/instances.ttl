<https://riskfolio-graphrag.io/kg/v2/Tutorial%2017%20-%20Riskfolio-Lib%20with%20MOSEK%20for%20Real%20Applications%20(612%20assets%20and%204943%20observations).ipynb::chunk:25> a rf:Chunk ;
    rf:chunk_index 25 ;
    rf:chunk_kind "example_cell" ;
    rf:content """rp_cagr = {} 
for rm in rms:
    a = np.prod(1 + Y @ w_rp_s[rm]) ** (360/days)-1
    rp_cagr[rm] = [a]

rp_cagr = pd.DataFrame(rp_cagr).T
rp_cagr.columns = ['CAGR']

rp_cagr.style.format("{:.2%}").background_gradient(cmap='RdYlGn')""" ;
