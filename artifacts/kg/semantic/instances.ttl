    rf:chunk_index 20 ;
    rf:chunk_kind "example_section" ;
    rf:content "### 3.3.2 Plotting portfolio composition in the network" ;
    rf:content_hash "92ac32d0b42853fe89c4dafb819adfe3ff7796e2c2a1763eb43a82c22c7cea2d" ;
