    rf:chunk_kind "example_section" ;
    rf:content "### 3.4 Calculate Optimal Portfolios for Several Risk Measures" ;
    rf:content_hash "028a313e545fb1f2ac8f6d9c2bfe8a402234b83150b7d7ca86c7479d65c1cf9d" ;
    rf:line_end 17 ;
    rf:line_start 17 ;
    rf:relative_path "Tutorial 43 - Risk Parity with a Risk Constraint per Classes.ipynb" ;
    rf:section "example_section" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 43 - Risk Parity with a Risk Constraint per Classes.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2043%20-%20Risk%20Parity%20with%20a%20Risk%20Constraint%20per%20Classes.ipynb::chunk:19> a rf:Chunk ;
    rf:chunk_index 19 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Risk Measures available:
#
# 'MV': Standard Deviation.
# 'MAD': Mean Absolute Deviation.
# 'MSV': Semi Standard Deviation.
# 'FLPM': First Lower Partial Moment (Omega Ratio).
# 'SLPM': Second Lower Partial Moment (Sortino Ratio).
# 'CVaR': Conditional Value at Risk.
# 'EVaR': Entropic Value at Risk.
# 'CDaR': Conditional Drawdown at Risk of uncompounded cumulative returns.
# 'EDaR': Entropic Drawdown at Risk of uncompounded cumulative returns.
# 'UCI': Ulcer Index of uncompounded cumulative returns.

rms = ['MV', 'MAD', 'MSV', 'FLPM', 'SLPM',
       'CVaR', 'CDaR', 'UCI']

w_s = pd.DataFrame([])
port.solvers = ['MOSEK']

for i in rms:
    w = port.rp_optimization(model=model, rm=i, rf=rf, b=b, hist=hist)
    w_s = pd.concat([w_s, w], axis=1)
    
w_s.columns = rms""" ;
    rf:content_hash "0288d6e6d603804534d40f5572036fb45edc8977bf7ecd2db578c0f9c4c7e0b4" ;
    rf:line_end 18 ;
    rf:line_start 18 ;
    rf:relative_path "Tutorial 43 - Risk Parity with a Risk Constraint per Classes.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 43 - Risk Parity with a Risk Constraint per Classes.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2043%20-%20Risk%20Parity%20with%20a%20Risk%20Constraint%20per%20Classes.ipynb::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import numpy as np
import pandas as pd
import yfinance as yf
import warnings

warnings.filterwarnings("ignore")
pd.options.display.float_format = '{:.4%}'.format

# Date range
start = '2016-01-01'
end = '2019-12-30'

# Tickers of assets
assets = ['JCI', 'TGT', 'CMCSA', 'CPB', 'MO', 'APA', 'MMC', 'JPM',
          'ZION', 'PSA', 'BAX', 'BMY', 'LUV', 'PCAR', 'TXT', 'TMO',
          'DE', 'MSFT', 'HPQ', 'SEE', 'VZ', 'CNP', 'NI', 'T', 'BA']
assets.sort()

# Downloading data
data = yf.download(assets, start = start, end = end, auto_adjust=False)
data = data.loc[:,('Adj Close', slice(None))]
data.columns = assets""" ;
