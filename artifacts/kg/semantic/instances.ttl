        self.mu_fm = mu
        self.cov_fm = cov
        self.kurt_fm = kurt
        self.returns_fm = returns

        if B_.shape[1] == len(self.factorslist):
            self.B = pd.DataFrame(B_, index=self.assetslist, columns=self.factorslist)
