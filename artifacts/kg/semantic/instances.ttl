<https://riskfolio-graphrag.io/kg/v2/Tutorial%2014%20-%20Mean%20Ulcer%20Index%20Portfolio%20Optimization.ipynb::chunk:2> a rf:Chunk ;
    rf:chunk_index 2 ;
    rf:chunk_kind "example_cell" ;
    rf:content """import numpy as np
import pandas as pd
import yfinance as yf
import warnings

warnings.filterwarnings("ignore")
pd.options.display.float_format = '{:.4%}'.format

# Date range
start = '2016-01-01'
end = '2019-12-30'

# Tickers of assets
assets = ['JCI', 'TGT', 'CMCSA', 'CPB', 'MO', 'APA', 'MMC', 'JPM',
          'ZION', 'PSA', 'BAX', 'BMY', 'LUV', 'PCAR', 'TXT', 'TMO',
          'DE', 'MSFT', 'HPQ', 'SEE', 'VZ', 'CNP', 'NI', 'T', 'BA']
assets.sort()

# Downloading data
data = yf.download(assets, start = start, end = end, auto_adjust=False)
data = data.loc[:,('Adj Close', slice(None))]
data.columns = assets""" ;
    rf:content_hash "67fd9b80a4d2dd9b24e7bff55c7cc3e59cf2ae0dfc43cf149263cc9f75773ab1" ;
    rf:line_end 2 ;
    rf:line_start 2 ;
    rf:relative_path "Tutorial 14 - Mean Ulcer Index Portfolio Optimization.ipynb" ;
    rf:section "example_cell" ;
    rf:source_path "/Users/et/Desktop/Data_Projects/Riskfolio-Lib/examples/Tutorial 14 - Mean Ulcer Index Portfolio Optimization.ipynb" .

<https://riskfolio-graphrag.io/kg/v2/Tutorial%2014%20-%20Mean%20Ulcer%20Index%20Portfolio%20Optimization.ipynb::chunk:3> a rf:Chunk ;
    rf:chunk_index 3 ;
    rf:chunk_kind "example_cell" ;
    rf:content """# Calculating returns

Y = data[assets].pct_change().dropna()

display(Y.head())""" ;
    rf:content_hash "0cb5060c4a382688eda7a33caba553aedad428b972f909fa91353dd3c81370ef" ;
    rf:line_end 3 ;
    rf:line_start 3 ;
