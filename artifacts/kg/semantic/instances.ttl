ax = rp.plot_clusters(returns=Y,
                      codependence='pearson',
                      linkage='ward',
                      k=None,
                      max_k=10,
                      leaf_order=True,
                      dendrogram=True,
                      #linecolor='tab:purple',
                      ax=None)""" ;
    rf:content_hash "c7bb5e18cbda11b886f10b218e8efe95c03ecbcfe20f9be01bc1625a632b928d" ;
